<p :if={notice = Tenant.text([:home, :notice])} class="ua-wip" id="under-construction">
  {notice}
</p>

<div :if={@next_tournament} class="ua-announce">
  <.tag kind="info">{gettext("Next tournament")}</.tag>
  <span>
    {@next_tournament.title}, {long_date(@next_tournament.starts_on)}{if @next_tournament.city,
      do: ", #{@next_tournament.city}"}
  </span>
  <a href={
    @next_tournament.link ||
      ~p"/calendar?#{[month: Calendar.strftime(@next_tournament.starts_on, "%Y-%m")]}"
  }>
    {gettext("Details")}
  </a>
</div>

<div class="ua-hero">
  <div>
    <span class="kicker">{Tenant.text([:home, :kicker])}</span>
    <h1>
      {Tenant.text([:home, :heading])} <em>{Tenant.text([:home, :heading_em])}</em>
    </h1>
    <p class="lead">{Tenant.text([:home, :lead])}</p>
    <div class="ua-acts">
      <a class="btn-go" href={~p"/calendar?#{[kind: "tournament"]}"}>
        {gettext("Upcoming tournaments")}
      </a>
      <a class="btn-quiet" href={~p"/clubs"}>{gettext("Find a club")}</a>
    </div>
  </div>
  <div class="ua-hero-map">
    <.club_map counts={@counts} labels={false} />
    <div class="ua-meta">
      {ngettext("%{count} club", "%{count} clubs", @club_count)}, {ngettext(
        "%{count} city",
        "%{count} cities",
        @city_count
      )}
    </div>
  </div>
</div>

<.stats>
  <:stat label={gettext("Active clubs")}>{@club_count}</:stat>
  <:stat label={gettext("Cities")}>{@city_count}</:stat>
  <:stat label={Tenant.text([:labels, :branches])}>{length(Public.Geo.branches())}</:stat>
  <:stat label={gettext("Upcoming events")}>{length(@upcoming)}</:stat>
</.stats>

<.section title={gettext("News")} bare>
  <:action href={~p"/news"}>{gettext("All news")}</:action>
  <div :if={@news != []} class="ua-newslist">
    <.news_card post={hd(@news)} featured />
    <div :if={tl(@news) != []} class="ua-cards">
      <.news_card :for={post <- tl(@news)} post={post} />
    </div>
  </div>
  <.empty :if={@news == []}>{gettext("No news yet.")}</.empty>
</.section>

<div class="ua-duo">
  <.section title={gettext("Upcoming events")}>
    <:action href={~p"/calendar"}>{gettext("Calendar")}</:action>
    <div :if={@upcoming != []} class="ua-events">
      <.event_row :for={event <- @upcoming} event={event} href={~p"/calendar/#{event.id}"} />
    </div>
    <div :if={@upcoming == []} class="pad">{gettext("Nothing planned yet.")}</div>
  </.section>

  <.section title={gettext("Our story")} pad>
    <:action :if={Tenant.page("about")} href={~p"/about"}>
      {Tenant.text([:home, :about_link])}
    </:action>
    <ol class="ua-story">
      <li :for={{year, text} <- story()}><b>{year}</b><span>{text}</span></li>
    </ol>
  </.section>
</div>
