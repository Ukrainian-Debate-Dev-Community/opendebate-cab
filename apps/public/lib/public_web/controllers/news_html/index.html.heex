<.page_head
  kicker={gettext("News")}
  title={Public.Tenant.text([:labels, :news])}
  lead={gettext("Announcements, tournament results, interviews and tips for debaters.")}
/>

<nav :if={length(@rubrics) > 1 or @rubric} class="toolbar" aria-label={gettext("Rubrics")}>
  <div class="pills">
    <a class={is_nil(@rubric) && "on"} href={~p"/news"}>{gettext("All")}</a>
    <a :for={r <- @rubrics} class={r == @rubric && "on"} href={~p"/news?#{[rubric: r]}"}>
      {rubric_label(r)}
    </a>
  </div>
</nav>

<div :if={@featured} class="newslist">
  <.news_card post={@featured} featured />
  <div :if={@posts != []} class="cards">
    <.news_card :for={post <- @posts} post={post} />
  </div>
</div>

<.empty :if={!@featured}>
  <%= if @rubric do %>
    {gettext("No news in this rubric yet.")}
    <a href={~p"/news"}>{gettext("See all news")}</a>
  <% else %>
    {gettext("No news here yet. Announcements and results will appear here.")}
  <% end %>
</.empty>
