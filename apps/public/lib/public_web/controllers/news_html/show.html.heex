<article class="ua-article">
  <header class="ua-article-head">
    <nav class="ua-crumbs" aria-label={gettext("Breadcrumbs")}>
      <a href={~p"/news"}>{gettext("News")}</a>
      <span class="sep" aria-hidden="true">/</span>
      <a class="ua-rubric" href={~p"/news?#{[rubric: @post.rubric]}"}>{rubric_label(@post.rubric)}</a>
    </nav>
    <h1>{@post.title}</h1>
    <p :if={@post.summary} class="ua-lead">{@post.summary}</p>
    <div class="ua-byline"><.news_meta post={@post} /></div>
  </header>

  <%!-- a cover only when the post has an image: no drawing here --%>
  <div :if={@post.image} class="ua-article-cover">
    <.cover post={@post} class="ua-cover--wide" />
  </div>

  <div class="ua-body">{Phoenix.HTML.raw(@body)}</div>

  <footer class="ua-article-foot">
    <span class="ua-share">{gettext("Share this article")}
    <.copy text={url(@conn, ~p"/news/#{@post.slug}")} /></span>
    <a class="ua-back" href={~p"/news"}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg>
      {gettext("All news")}
    </a>
  </footer>
</article>

<.section :if={@more != []} id="more-news" title={gettext("More news")} bare>
  <:action href={~p"/news"}>{gettext("All news")}</:action>
  <div class="ua-cards"><.news_card :for={post <- @more} post={post} /></div>
</.section>
