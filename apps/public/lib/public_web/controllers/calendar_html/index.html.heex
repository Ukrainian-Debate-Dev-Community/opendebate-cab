<.page_head
  kicker={gettext("Calendar")}
  title={gettext("Tournaments and events")}
  lead={Public.Tenant.text([:labels, :calendar_lead])}
>
  <:actions>
    <a class="btn-go" href={~p"/calendar/request"} id="request-event">
      {gettext("Request an event")}
    </a>
    <a :if={@calendar_public} class="btn-quiet" href={~p"/calendar.ics"}>
      {gettext("Subscribe to the calendar")}
    </a>
  </:actions>
</.page_head>

<%= if @calendar_public do %>
  <.toolbar period={@period} kind={@kind} base={~p"/calendar"} />

  <%!-- a month: the grid with its events beside it; a year or all: the list --%>
  <div class={if @period.view == :month, do: "split", else: "stack"}>
    <.section :if={@period.view == :month} id="calendar-month" title={period_title(@period)}>
      <.month_grid
        first={@period.first}
        events={@events}
        href={&link(~p"/calendar/#{&1.id}", @period, @kind, nil)}
      />
    </.section>

    <div class="stack">
      <.section :for={{heading, events} <- groups(@period, @events)} title={heading}>
        <div class="ua-events">
          <.event_row
            :for={{event, i} <- Enum.with_index(events)}
            event={event}
            id={first_of_day?(events, i) && day_anchor(event.starts_on)}
            href={link(~p"/calendar/#{event.id}", @period, @kind, nil)}
          />
        </div>
      </.section>
      <.empty :if={@events == []}>{empty_text(@period)}</.empty>
    </div>
  </div>
<% else %>
  <.empty id="calendar-not-public">
    {gettext("The calendar is not public yet. Tournaments will appear here soon.")}
  </.empty>
<% end %>
