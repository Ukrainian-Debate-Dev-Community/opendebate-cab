<.chrome
  crumbs={if @tag, do: [{gettext("Tags"), ~p"/manage/tags"}], else: []}
  here={if @tag, do: gettext("Edit tag"), else: gettext("Tags")}
>
  <:seg :if={@tag} href={~p"/manage/tags/#{@tag.id}"} method="delete" quiet>
    {gettext("Delete")}
  </:seg>
</.chrome>

<.card class="ua-form">
  <.form_for
    id="tag-form"
    action={if @tag, do: ~p"/manage/tags/#{@tag.id}", else: ~p"/manage/tags"}
    method={if @tag, do: "put", else: "post"}
    title={if @tag, do: @tag.name, else: gettext("New tag")}
    description={
      gettext(
        "Tags mark events and news for the editors, a status for example. They are private: the public site never shows them."
      )
    }
    errors={field_errors(@form)}
  >
    <:block
      name={field_name(@form, :name)}
      label={gettext("Text")}
      required
      maxlength={40}
      value={@form[:name].value}
    />
    <:block name={field_name(@form, :color)} type={:custom} label={gettext("Colour")}>
      <div class="ua-swatches">
        <label
          :for={color <- Public.Tags.Tag.colors()}
          class={["ua-label", "ua-label--#{color}"]}
        >
          <input
            type="radio"
            name="tag[color]"
            value={color}
            checked={(@form[:color].value || "gray") == color}
          />
          {color_label(color)}
        </label>
      </div>
    </:block>
    <:submit>{gettext("Save")}</:submit>
  </.form_for>
</.card>

<.section title={gettext("Tags")}>
  <.table id="tags" rows={@tags} empty={gettext("No tags yet.")}>
    <:col :let={tag} label={gettext("Tag")}><.tag_chips tags={[tag]} /></:col>
    <:col :let={tag} label={gettext("Colour")}>{color_label(tag.color)}</:col>
    <:col :let={tag}>
      <a class="btn-quiet btn-sm" href={~p"/manage/tags/#{tag.id}/edit"}>{gettext("Edit")}</a>
    </:col>
  </.table>
</.section>
