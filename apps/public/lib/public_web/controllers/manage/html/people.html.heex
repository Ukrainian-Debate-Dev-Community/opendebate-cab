<.chrome here={gettext("Content managers")} />

<.card class="ua-form">
  <.form_for
    id="grant-form"
    action={~p"/manage/people"}
    title={gettext("Grant the content-manager role")}
    description={gettext("To a person who has signed in to cab at least once.")}
  >
    <:block
      name="login"
      label={gettext("Person")}
      required
      hint={gettext("Their exact cab username or e-mail.")}
    />
    <:submit>{gettext("Grant the role")}</:submit>
  </.form_for>
</.card>

<.section title={gettext("Content managers")}>
  <.table id="roles" rows={@roles} empty={gettext("Nobody holds the role yet.")}>
    <:col :let={row} label={gettext("Person")}>
      {row.user && display_name(row.user)}
      <.sub :if={row.user}>{row.user.username}</.sub>
    </:col>
    <:col :let={row} label={gettext("Since")}>{long_date(row.role.inserted_at)}</:col>
    <:col :let={row} label={gettext("Granted by")}>
      {if row.granted_by,
        do: display_name(row.granted_by),
        else: gettext("set up from the server")}
    </:col>
    <:col :let={row}>
      <.button_to action={~p"/manage/people/#{row.role.user_id}"} method="delete">
        {gettext("Revoke")}
      </.button_to>
    </:col>
  </.table>
</.section>
