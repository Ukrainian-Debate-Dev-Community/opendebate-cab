<.chrome here={gettext("News")}>
  <:seg href={~p"/manage/news/new"} primary>{gettext("Write news")}</:seg>
</.chrome>

<.tag_filter
  tags={@tags}
  selected={@tag}
  href={fn tag -> if tag, do: ~p"/manage/news?#{[tag: tag.id]}", else: ~p"/manage/news" end}
/>

<.card>
  <.table
    id="news"
    rows={@posts}
    empty={
      if @tag,
        do: gettext("No news with this tag."),
        else: gettext("No news yet. Write the first one.")
    }
  >
    <:col :let={post} label={gettext("Title")}>
      <a href={~p"/manage/news/#{post.id}/edit"}>{post.title}</a>
    </:col>
    <:col :let={post} label={gettext("Rubric")}>{rubric_label(post.rubric)}</:col>
    <:col :let={post} label={gettext("Status")}>
      <.tag :if={post.published_at} kind="ok">
        {gettext("Published %{date}", date: long_date(post.published_at))}
      </.tag>
      <.tag :if={!post.published_at}>{gettext("Draft")}</.tag>
    </:col>
    <:col :let={post} label={gettext("Tags")}><.tag_chips tags={post.tags} /></:col>
    <:col :let={post}>
      <.button_to :if={!post.published_at} action={~p"/manage/news/#{post.id}/publish"}>
        {gettext("Publish")}
      </.button_to>
      <.button_to :if={post.published_at} action={~p"/manage/news/#{post.id}/unpublish"}>
        {gettext("Unpublish")}
      </.button_to>
    </:col>
  </.table>
</.card>
