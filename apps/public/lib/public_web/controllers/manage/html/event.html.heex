<.chrome crumbs={[{gettext("Calendar"), @back}]} here={@event.title}>
  <:seg
    id="event-visibility"
    href={
      with_query(@visibility_action,
        visibility: if(@event.visibility == "private", do: "public", else: "private"),
        back: "event"
      )
    }
    method="post"
  >
    {if @event.visibility == "private", do: gettext("Make public"), else: gettext("Make private")}
  </:seg>
  <:seg href={~p"/manage/events/#{@event.id}/edit"}>{gettext("Edit")}</:seg>
  <:seg href={~p"/manage/events/#{@event.id}"} method="delete" quiet>{gettext("Delete")}</:seg>
</.chrome>

<.page_head kicker={gettext("Calendar")} title={@event.title}>
  <:actions :if={@event.link}>
    <a class="btn-go" href={@event.link} target="_blank" rel="noopener" id="event-link">
      {gettext("Event website")}
    </a>
  </:actions>
</.page_head>

<PublicWeb.CalendarHTML.event_body event={@event}>
  <:tags>
    <.tag :if={@event.visibility == "private"} kind="priv">{gettext("Private")}</.tag>
    <.tag_chips tags={@event.tags} />
  </:tags>
</PublicWeb.CalendarHTML.event_body>
