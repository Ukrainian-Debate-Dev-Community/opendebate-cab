<.page_head
  kicker={gettext("Manage")}
  title={gettext("Overview")}
  lead={
    gettext(
      "You reached this through the link you were given; it works only while you hold the role."
    )
  }
>
  <:actions>
    <a class="btn-quiet" href={~p"/manage/events/new"}>{gettext("New event")}</a>
    <a class="btn-go" href={~p"/manage/news/new"}>{gettext("Write news")}</a>
  </:actions>
</.page_head>

<.stats id="manage-stats">
  <:stat label={gettext("Published news")}>{@published}</:stat>
  <:stat label={gettext("Drafts")}>{@drafts}</:stat>
  <:stat label={gettext("Upcoming events")}>{@upcoming_count}</:stat>
  <:stat label={gettext("Of them private")}>{@private_count}</:stat>
</.stats>

<.section title={gettext("Coming up")} bare>
  <:action href={~p"/manage/calendar"}>{gettext("Calendar")}</:action>
  <.event_row :for={event <- @upcoming} event={event} href={~p"/manage/events/#{event.id}"}>
    <.tag_chips tags={event.tags} />
    <a class="btn-quiet btn-sm" href={~p"/manage/events/#{event.id}/edit"}>
      {gettext("Edit")}
    </a>
  </.event_row>
  <.empty :if={@upcoming == []}>{gettext("Nothing planned yet.")}</.empty>
</.section>
