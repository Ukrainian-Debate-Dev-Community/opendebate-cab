<.chrome here={gettext("Event requests from the public")} />

<.section title={gettext("Pending")} bare>
  <.empty :if={@pending == []} id="requests-none">{gettext("No pending requests.")}</.empty>
  <.card :for={request <- @pending} class="ua-request" id={"request-#{request.id}"} pad>
    <div class="ua-meta">
      {gettext("Received %{date} from %{email}",
        date: long_date(request.inserted_at),
        email: request.email
      )}
    </div>
    <dl class="ua-answers">
      <%= for answer <- request.answers, answer["id"] != "email" do %>
        <dt>{Ui.FormComponents.field_label(answer)}</dt>
        <dd>{Ui.FormComponents.answer_text(answer)}</dd>
      <% end %>
    </dl>
    <div class="ua-request-actions">
      <a class="btn-quiet" href={~p"/manage/events/new?#{[request: request.id]}"}>
        {gettext("Accept: add the event")}
      </a>
      <.form
        for={%{}}
        action={~p"/manage/requests/#{request.id}/decline"}
        method="post"
        class="ua-decline"
      >
        <input
          type="text"
          name="reason"
          maxlength="1000"
          placeholder={gettext("Reason (optional, sent to the requester)")}
          aria-label={gettext("Reason")}
        />
        <button type="submit" class="btn-quiet">{gettext("Decline")}</button>
      </.form>
    </div>
  </.card>
</.section>

<.section title={gettext("Decided")}>
  <.table id="requests-decided" rows={@decided} empty={gettext("Nothing decided yet.")}>
    <:col :let={request} label={gettext("Request")}>
      {Core.Forms.first_value(request.answers, "text") || request.email}
      <.sub>{request.email}</.sub>
    </:col>
    <:col :let={request} label={gettext("Decision")}>
      {if request.status == "accepted", do: gettext("accepted"), else: gettext("declined")}
      <.sub :if={request.reason}>{request.reason}</.sub>
    </:col>
    <:col :let={request} label={gettext("Decided")}>{long_date(request.decided_at)}</:col>
  </.table>
</.section>

<.section title={gettext("The request form")} id="request-form">
  <:action href={~p"/calendar/request"}>{gettext("Open the page")}</:action>
  <div class="pad">
    <p>
      {gettext(
        "What the public is asked on the calendar's request page; the e-mail is always asked first."
      )}
    </p>
  </div>
  <Ui.FormComponents.form_editor
    definition={@definition}
    page={~p"/manage/requests"}
    fields={~p"/manage/requests/form/fields"}
    editing={@editing}
    values={@values}
    errors={@errors}
  />
  <div class="pad">
    <button type="submit" form="field-form" class="btn-go">
      {if @editing, do: gettext("Save the field"), else: gettext("Add the field")}
    </button>
    <a :if={@editing} class="btn-quiet" href={~p"/manage/requests#request-form"}>
      {gettext("Cancel")}
    </a>
  </div>
</.section>
