<%!-- the rich text block's editor, loaded by ui.js on this page only --%>
<meta name="rich-editor-src" content={~p"/assets/js/rich-editor.js"} />

<.chrome
  crumbs={[{gettext("News"), ~p"/manage/news"}]}
  here={if @post, do: gettext("Edit"), else: gettext("New")}
>
  <:seg
    form="news-form"
    formaction={
      if @post, do: ~p"/manage/news/#{@post.id}/preview", else: ~p"/manage/news/preview"
    }
    formtarget="_blank"
    quiet
  >
    {gettext("Preview")}
  </:seg>
  <:seg :if={@post && @post.published_at} href={~p"/news/#{@post.slug}"}>
    {gettext("View")}
  </:seg>
  <:seg
    :if={@post && !@post.published_at}
    href={~p"/manage/news/#{@post.id}/publish"}
    method="post"
  >
    {gettext("Publish")}
  </:seg>
</.chrome>

<.card class="ua-form">
  <.form_for
    id="news-form"
    action={if @post, do: ~p"/manage/news/#{@post.id}", else: ~p"/manage/news"}
    method={if @post, do: "put", else: "post"}
    enctype="multipart/form-data"
    title={if @post, do: @post.title, else: gettext("Write news")}
    description={gettext("Saved as a draft until you publish it.")}
    errors={news_errors(@form)}
    switch="post[edit_lang]"
  >
    <:block
      name="post[edit_lang]"
      type={:select}
      label={gettext("Language")}
      options={for {code, _short, name} <- PublicWeb.Locale.names(), do: {name, code}}
      value={@edit_lang}
      hint={
        gettext(
          "Write the post in one language or both. Visitors read their own language when the post has it, else the one it has."
        )
      }
    />
    <:block
      :for={lang <- Public.News.Post.langs()}
      name={"post[i18n][#{lang}][title]"}
      group={lang}
      label={gettext("Title")}
      maxlength={200}
      value={@i18n[lang]["title"]}
    />
    <:block
      name={field_name(@form, :slug)}
      label={gettext("Address")}
      maxlength={200}
      value={@form[:slug].value}
      hint={gettext("The end of the link, /news/... Left empty, it is made from the title.")}
    />
    <:block
      name={field_name(@form, :rubric)}
      type={:select}
      label={gettext("Rubric")}
      options={for r <- Public.News.Post.rubrics(), do: {rubric_label(r), r}}
      value={@form[:rubric].value}
    />
    <:block
      name={field_name(@form, :image)}
      type={:file}
      label={gettext("Cover image")}
      accept="image/jpeg,image/png,image/webp"
      preview={@post && @post.image && Public.Uploads.url(@post.image)}
      preview_alt={@post && @post.image_alt}
      remove={field_name(@form, :remove_image)}
      remove_label={gettext("Remove the image")}
      hint={
        gettext("JPEG, PNG or WebP, up to %{mb} MB. Without an image the card shows a drawing.",
          mb: @max_mb
        )
      }
    />
    <:block
      :for={lang <- Public.News.Post.langs()}
      name={"post[i18n][#{lang}][image_alt]"}
      group={lang}
      label={gettext("Image description")}
      maxlength={200}
      value={@i18n[lang]["image_alt"]}
      hint={gettext("What the image shows, for people who cannot see it.")}
    />
    <:block
      :for={lang <- Public.News.Post.langs()}
      name={"post[i18n][#{lang}][summary]"}
      group={lang}
      type={:longtext}
      label={gettext("Summary")}
      rows={3}
      maxlength={1000}
      value={@i18n[lang]["summary"]}
      hint={gettext("One or two sentences shown above the article.")}
    />
    <:block
      :for={lang <- Public.News.Post.langs()}
      name={"post[i18n][#{lang}][body]"}
      group={lang}
      type={:rich}
      label={gettext("Text")}
      rows={14}
      value={@i18n[lang]["body"]}
      upload={@images}
      placeholder={gettext("Write the article...")}
      hint={
        gettext(
          "Select words to make them bold or a link. Images: JPEG, PNG or WebP, up to %{mb} MB.",
          mb: @max_mb
        )
      }
    />
    <:block name="post[tag_ids][]" type={:custom} label={gettext("Tags")}>
      <.tag_picker name="post[tag_ids][]" tags={@tags} selected={@selected_tags} />
    </:block>
    <:submit>{gettext("Save")}</:submit>
  </.form_for>
</.card>
