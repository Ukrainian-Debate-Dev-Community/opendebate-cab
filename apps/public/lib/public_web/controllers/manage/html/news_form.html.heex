<.chrome
  crumbs={[{gettext("News"), ~p"/manage/news"}]}
  here={if @post, do: gettext("Edit"), else: gettext("New")}
>
  <:seg :if={@post && @post.published_at} href={~p"/news/#{@post.slug}"}>
    {gettext("View")}
  </:seg>
  <:seg
    :if={@post && !@post.published_at}
    href={~p"/manage/news/#{@post.id}/publish"}
    method="post"
  >
    {gettext("Publish")}
  </:seg>
</.chrome>

<.card class="ua-form">
  <.form_for
    id="news-form"
    action={if @post, do: ~p"/manage/news/#{@post.id}", else: ~p"/manage/news"}
    method={if @post, do: "put", else: "post"}
    enctype="multipart/form-data"
    title={if @post, do: @post.title, else: gettext("Write news")}
    description={gettext("Saved as a draft until you publish it.")}
    errors={field_errors(@form)}
  >
    <:block
      name={field_name(@form, :title)}
      label={gettext("Title")}
      required
      maxlength={200}
      value={@form[:title].value}
    />
    <:block
      name={field_name(@form, :slug)}
      label={gettext("Address")}
      maxlength={200}
      value={@form[:slug].value}
      hint={gettext("The end of the link, /news/... Left empty, it is made from the title.")}
    />
    <:block
      name={field_name(@form, :rubric)}
      type={:select}
      label={gettext("Rubric")}
      options={for r <- Public.News.Post.rubrics(), do: {rubric_label(r), r}}
      value={@form[:rubric].value}
    />
    <:block
      name={field_name(@form, :image)}
      type={:file}
      label={gettext("Cover image")}
      accept="image/jpeg,image/png,image/webp"
      preview={@post && @post.image && Public.Uploads.url(@post.image)}
      preview_alt={@post && @post.image_alt}
      remove={field_name(@form, :remove_image)}
      remove_label={gettext("Remove the image")}
      hint={
        gettext("JPEG, PNG or WebP, up to %{mb} MB. Without an image the card shows a gradient.",
          mb: @max_mb
        )
      }
    />
    <:block
      name={field_name(@form, :image_alt)}
      label={gettext("Image description")}
      maxlength={200}
      value={@form[:image_alt].value}
      hint={gettext("What the image shows, for people who cannot see it.")}
    />
    <:block
      name={field_name(@form, :summary)}
      type={:longtext}
      label={gettext("Summary")}
      rows={3}
      maxlength={1000}
      value={@form[:summary].value}
      hint={gettext("One or two sentences shown above the article.")}
    />
    <:block
      name={field_name(@form, :body)}
      type={:longtext}
      label={gettext("Text")}
      rows={14}
      maxlength={20000}
      value={@form[:body].value}
      hint={
        gettext("Markdown: ## for a heading, **bold**, [a link](https://...), > for a quote.")
      }
    />
    <:block name="post[tag_ids][]" type={:custom} label={gettext("Tags")}>
      <.tag_picker name="post[tag_ids][]" tags={@tags} selected={@selected_tags} />
    </:block>
    <:submit>{gettext("Save")}</:submit>
  </.form_for>
</.card>
