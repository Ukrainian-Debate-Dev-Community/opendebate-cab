<.chrome
  crumbs={[{gettext("Calendar"), ~p"/manage/calendar"}]}
  here={if @event, do: gettext("Edit event"), else: gettext("New event")}
>
  <:seg :if={@event} href={~p"/manage/events/#{@event.id}"} method="delete" quiet>
    {gettext("Delete")}
  </:seg>
</.chrome>

<.banner :if={@request} id="from-request">
  {gettext("From a request by %{email}: check it and save to accept the request.",
    email: @request.email
  )}
</.banner>

<.card class="ua-form">
  <.form_for
    id="event-form"
    action={if @event, do: ~p"/manage/events/#{@event.id}", else: ~p"/manage/events"}
    method={if @event, do: "put", else: "post"}
    title={if @event, do: @event.title, else: gettext("New event")}
    description={
      gettext("Public events appear on the calendar, the home page and the iCal feed.")
    }
    errors={field_errors(@form)}
    hidden={if @request, do: [{"request_id", @request.id}], else: []}
  >
    <:block
      name={field_name(@form, :title)}
      label={gettext("Title")}
      required
      maxlength={200}
      value={@form[:title].value}
    />
    <:block
      name={field_name(@form, :kind)}
      type={:select}
      label={gettext("Kind")}
      options={for k <- Public.Events.Event.kinds(), do: {kind_label(k), k}}
      value={@form[:kind].value}
    />
    <:block
      name={field_name(@form, :starts_on)}
      type={:date}
      label={gettext("Starts")}
      required
      value={@form[:starts_on].value}
    />
    <:block
      name={field_name(@form, :ends_on)}
      type={:date}
      label={gettext("Ends")}
      value={@form[:ends_on].value}
    />
    <:block
      name={field_name(@form, :city)}
      label={gettext("City")}
      maxlength={80}
      value={@form[:city].value}
    />
    <:block
      name={field_name(@form, :format)}
      label={gettext("Format")}
      maxlength={80}
      value={@form[:format].value}
    />
    <:block
      name={field_name(@form, :language)}
      type={:select}
      label={gettext("Language")}
      options={
        for code <- Public.Events.Event.languages(),
            do: {if(code == "other", do: gettext("Other"), else: language_label(code)), code}
      }
      value={@form[:language].value}
      other="other"
      other_name={field_name(@form, :language_other)}
      other_value={@form[:language_other].value}
      other_placeholder={gettext("e.g. Polish")}
    />
    <:block
      name={field_name(@form, :link)}
      label={gettext("Link")}
      input="url"
      maxlength={255}
      value={@form[:link].value}
      hint={gettext("Registration or the tournament's page, https://...")}
    />
    <:block
      name={field_name(@form, :details)}
      type={:longtext}
      label={gettext("Details")}
      rows={5}
      maxlength={5000}
      value={@form[:details].value}
    />
    <:block
      name={field_name(@form, :visibility)}
      type={:select}
      label={gettext("Visibility")}
      options={[
        {gettext("Public"), "public"},
        {gettext("Private: only content managers see it"), "private"}
      ]}
      value={@form[:visibility].value || "public"}
    />
    <:block name="event[tag_ids][]" type={:custom} label={gettext("Tags")}>
      <.tag_picker name="event[tag_ids][]" tags={@tags} selected={@selected_tags} />
    </:block>
    <:submit>{gettext("Save")}</:submit>
  </.form_for>
</.card>
