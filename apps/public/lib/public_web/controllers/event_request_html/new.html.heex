<.page_head
  kicker={gettext("Calendar")}
  title={gettext("Request an event")}
  lead={
    gettext(
      "Tell us about your tournament or event. We will write to you once it is decided; a copy of your request goes to your e-mail."
    )
  }
/>

<.banner :if={@errors[:form]} kind={:bad} id="request-limited">{@errors[:form]}</.banner>

<.card class="ua-form">
  <.form_for
    id="event-request-form"
    action={~p"/calendar/request"}
    title={gettext("Your event")}
    errors={@errors}
    guard={CabWeb.Turnstile.site_key()}
  >
    <:block
      :for={field <- @fields}
      name={answer_name(field)}
      type={block_type(field)}
      label={field_label(field)}
      required={field["required"]}
      hint={field["hint"]}
      options={field["options"]}
      value={@answers[field["id"]]}
      input={input_type(field)}
      placeholder={placeholder(field)}
      prompt={prompt(field)}
    />
    <:submit>{gettext("Send the request")}</:submit>
  </.form_for>
</.card>

<%!-- the contact fields' behaviour (phone formatting and checks): a
     bundle of its own, loaded only where a form has such fields --%>
<script defer src={~p"/assets/js/contact-fields.js"}>
</script>
