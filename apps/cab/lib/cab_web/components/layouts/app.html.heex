<div class="shell">
  <CabWeb.Ui.sidenav
    current_user={@current_user}
    club={@club}
    club_role={@club_role}
    nav_session={@nav_session}
    active={@active}
  />
  <div class="mainc">
    <main class="page-main">
      {render_slot(@inner_block)}
    </main>
    <footer class="footer">
      <div class="in">
        <div class="cols">
          <div>
            <h6>{gettext("Find your club")}</h6>
            <p>
              {CabWeb.Operator.get(:about) ||
                gettext("Clubs run weekly practice rounds: pick one and come debate.")}
            </p>
            <div :if={CabWeb.Operator.get(:site_url)} class="flinks">
              <a href={CabWeb.Operator.get(:site_url)}>{gettext("Main page")}</a>
            </div>
          </div>
          <div :if={CabWeb.Operator.get(:org_text)}>
            <h6>{gettext("Our organisation")}</h6>
            <p>{CabWeb.Operator.get(:org_text)}</p>
            <div class="flinks">
              <a :if={CabWeb.Operator.get(:org_url)} href={CabWeb.Operator.get(:org_url)}>
                {CabWeb.Operator.get(:org_label)}
              </a>
              <a
                :if={CabWeb.Operator.get(:contact_email)}
                href={"mailto:" <> CabWeb.Operator.get(:contact_email)}
              >
                {gettext("Contact us")}
              </a>
            </div>
          </div>
          <div>
            <h6>{gettext("Data & privacy")}</h6>
            <p>
              {gettext("cab is in beta testing.")}
            </p>
            <div class="flinks">
              <a href="/policy">{gettext("Policy")}</a>
              <a href="/terms">{gettext("Terms")}</a>
              <a
                :if={CabWeb.Operator.get(:support_email)}
                href={"mailto:" <> CabWeb.Operator.get(:support_email)}
              >
                {gettext("Support")}
              </a>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </div>
</div>
