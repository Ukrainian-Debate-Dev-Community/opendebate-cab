<div class="shell">
  <CabWeb.Ui.sidenav
    current_user={@current_user}
    club={@club}
    club_role={@club_role}
    nav_session={@nav_session}
    active={@active}
  />
  <div class="mainc">
    <main class="page-main">
      {render_slot(@inner_block)}
    </main>
    <footer class="footer">
      <div class="in">
        <div class="cols">
          <div>
            <h6>{gettext("Find your club")}</h6>
            <p>
              {gettext(
                "Clubs across Ukraine run weekly practice rounds — pick one and come debate. Free for every Ukrainian club."
              )}
            </p>
            <div class="flinks">
              <a href="https://uadebate.com">{gettext("Main page")}</a>
            </div>
          </div>
          <div>
            <h6>{gettext("Our organisation")}</h6>
            <p>
              {gettext(
                "Run by the NGO Debate Federation of Ukraine (ВМГО «Федерація Дебатів України»)."
              )}
            </p>
            <div class="flinks">
              <a href="https://dfu.uadebate.com">{gettext("DFU")}</a>
              <a href="mailto:ngo.dfu@uadebate.com">{gettext("Contact us")}</a>
            </div>
          </div>
          <div>
            <h6>{gettext("Data & privacy")}</h6>
            <p>
              {gettext("cab is in beta testing.")}
            </p>
            <div class="flinks">
              <a href="/policy">{gettext("Policy")}</a>
              <a href="/terms">{gettext("Terms")}</a>
              <a href="mailto:support@uadebate.com">{gettext("Support")}</a>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </div>
</div>
