<Layouts.app flash={@flash} current_user={@current_user} active="admin">
  <.chrome here="Admin">
    <:seg form="create-club-form" primary>Create club</:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section title="Clubs">
      <.table id="admin-clubs" rows={@clubs} empty="No clubs yet.">
        <:col :let={club} label="Club">
          {club.name}
          <.sub>
            {club.city || "—"}, {@member_counts[club.id] || 0} member{if (@member_counts[
                                                                            club.id
                                                                          ] || 0) != 1,
                                                                         do: "s"}
          </.sub>
        </:col>
        <:col :let={club} label="Head">
          {head_label(@heads[club.id])}
        </:col>
        <:col :let={club} label="State">
          {if club.archived_at, do: "archived", else: "live"}
        </:col>
        <:col :let={club}>
          <.link href={~p"/c/#{club.uuid}"}>open</.link>
        </:col>
        <:col :let={club}>
          <.link
            :if={is_nil(club.archived_at)}
            href={~p"/admin/clubs/#{club.uuid}/archive"}
            method="post"
          >
            archive
          </.link>
        </:col>
      </.table>
    </.section>

    <.section title="Create a club">
      <.form_for
        id="create-club-form"
        action={~p"/admin/clubs"}
        description="Club creation is admin-only — users can only request membership."
      >
        <:block name={:name} type={:text} label="Club name" required />
        <:block name={:city} type={:text} label="City" />
        <:block
          name={:head_id}
          type={:select}
          label="Head"
          required
          options={user_options(@users)}
        />
      </.form_for>
    </.section>

    <.section title="Change a club's head">
      <.form_for
        id="change-head-form"
        action={~p"/admin/head"}
        description="The new head takes over; the old head retires."
      >
        <:block
          name={:uuid}
          type={:select}
          label="Club"
          required
          options={club_options(@clubs)}
        />
        <:block
          name={:head_id}
          type={:select}
          label="New head"
          required
          options={user_options(@users)}
        />
        <:submit note="Takes effect immediately.">Change head</:submit>
      </.form_for>
    </.section>

    <.section title="Merge two accounts">
      <.form_for
        id="merge-accounts-form"
        action={~p"/admin/merge"}
        description="For one person who ended up with two accounts and cannot sign in to both. The account that heads a club is kept, or else the older one; it gets the other's history, clubs, head positions and sign-in methods. It cannot be undone."
      >
        <:block
          name={:first_id}
          type={:select}
          label="Account"
          required
          options={user_options(@users)}
        />
        <:block
          name={:second_id}
          type={:select}
          label="Same person's other account"
          required
          options={user_options(@users)}
        />
        <:submit note="Refused when both took part in the same session.">Merge accounts</:submit>
      </.form_for>
    </.section>
  </div>
</Layouts.app>
