<Layouts.app flash={@flash} current_user={@current_user} active="admin">
  <.chrome here={gettext("Admin")}>
    <:seg form="create-club-form" primary>{gettext("Create club")}</:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section title={gettext("Clubs")}>
      <.table id="admin-clubs" rows={@clubs} empty={gettext("No clubs yet.")}>
        <:col :let={club} label={gettext("Club")}>
          {club.name}
          <.sub>
            {club.city || "—"}, {ngettext(
              "%{count} member",
              "%{count} members",
              @member_counts[club.id] || 0
            )}
          </.sub>
        </:col>
        <:col :let={club} label={gettext("Head")}>
          {head_label(@heads[club.id])}
        </:col>
        <:col :let={club} label={gettext("State")}>
          {if club.archived_at, do: gettext("archived"), else: gettext("live")}
        </:col>
        <:col :let={club}>
          <.link href={~p"/c/#{club.uuid}"}>{gettext("open")}</.link>
        </:col>
        <:col :let={club}>
          <.link
            :if={is_nil(club.archived_at)}
            href={~p"/admin/clubs/#{club.uuid}/archive"}
            method="post"
          >
            {gettext("archive")}
          </.link>
        </:col>
      </.table>
    </.section>

    <.section title={gettext("Create a club")}>
      <.form_for
        id="create-club-form"
        action={~p"/admin/clubs"}
        description={gettext("Club creation is admin-only — users can only request membership.")}
      >
        <:block name={:name} type={:text} label={gettext("Club name")} required />
        <:block name={:city} type={:text} label={gettext("City")} />
        <:block
          name={:head}
          type={:text}
          label={gettext("Head")}
          required
          list="cab-accounts"
          placeholder={gettext("username or e-mail")}
          hint={
            gettext(
              "An account's username or e-mail. An e-mail no account uses sends an invitation instead."
            )
          }
        />
        <:block
          name={:head_name}
          type={:text}
          label={gettext("Their name")}
          hint={gettext("Only for an invitation: the name the e-mail greets.")}
        />
      </.form_for>
    </.section>

    <.section title={gettext("Change a club's head")}>
      <.form_for
        id="change-head-form"
        action={~p"/admin/head"}
        description={gettext("The new head takes over; the old head retires.")}
      >
        <:block
          name={:uuid}
          type={:select}
          label={gettext("Club")}
          required
          options={club_options(@clubs)}
        />
        <:block
          name={:head}
          type={:text}
          label={gettext("New head")}
          required
          list="cab-accounts"
          placeholder={gettext("username or e-mail")}
          hint={
            gettext(
              "An account's username or e-mail. An e-mail no account uses sends an invitation instead."
            )
          }
        />
        <:block
          name={:head_name}
          type={:text}
          label={gettext("Their name")}
          hint={gettext("Only for an invitation: the name the e-mail greets.")}
        />
        <:submit
          note={gettext("An account takes over at once; an invitation once it is accepted.")}
          quiet
        >
          {gettext("Change head")}
        </:submit>
      </.form_for>
    </.section>

    <.section :if={@head_invitations != []} title={gettext("Pending head invitations")}>
      <.table id="head-invitations" rows={@head_invitations}>
        <:col :let={invitation} label={gettext("Club")}>{invitation.club.name}</:col>
        <:col :let={invitation} label={gettext("Invited")}>
          {invitation.name}
          <.sub>{invitation.email}</.sub>
        </:col>
        <:col :let={invitation} label={gettext("Sent")}>{day(invitation.updated_at)}</:col>
        <:col :let={invitation} label={gettext("Expires")}>{day(invitation.expires_at)}</:col>
        <:col :let={invitation}>
          <.link href={~p"/admin/head-invitations/#{invitation.id}/resend"} method="post">
            {gettext("resend")}
          </.link>
        </:col>
        <:col :let={invitation}>
          <.link href={~p"/admin/head-invitations/#{invitation.id}/cancel"} method="post">
            {gettext("cancel")}
          </.link>
        </:col>
      </.table>
    </.section>

    <datalist id="cab-accounts">
      <option :for={account <- @accounts} value={account.username}>{account.name}</option>
    </datalist>

    <.section :if={length(@accounts) > 1} title={gettext("Merge two accounts")}>
      <.form_for
        id="merge-accounts-form"
        action={~p"/admin/merge"}
        description={
          gettext(
            "For one person who ended up with two accounts and cannot sign in to both. The account that heads a club is kept, or else the older one; it gets the other's history, clubs, head positions and sign-in methods. It cannot be undone."
          )
        }
      >
        <:block
          name={:first}
          type={:text}
          label={gettext("Account")}
          required
          list="cab-accounts"
          placeholder={gettext("username or e-mail")}
        />
        <:block
          name={:second}
          type={:text}
          label={gettext("Same person's other account")}
          required
          list="cab-accounts"
          placeholder={gettext("username or e-mail")}
        />
        <:submit note={gettext("Refused when both took part in the same session.")} quiet>
          {gettext("Merge accounts")}
        </:submit>
      </.form_for>
    </.section>
  </div>
</Layouts.app>
