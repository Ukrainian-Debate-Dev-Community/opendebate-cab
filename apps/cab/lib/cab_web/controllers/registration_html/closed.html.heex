<Layouts.app
  flash={@flash}
  current_user={assigns[:current_user]}
  club={@club}
  club_role={@club_role}
  nav_session={@session}
  active="register"
>
  <.chrome
    crumbs={[{@club.name, ~p"/c/#{@club.uuid}"}]}
    here={gettext("Register — %{stage}", stage: stage_words(@state.stage))}
  >
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.banner kind={:info}>{gettext("Registration is closed for this session.")}</.banner>

    <.section title={gettext("Registration")} pad>
      {gettext("Registration for")} <b>{@state.event["name"]}</b>
      {gettext("is closed.")}
      <p>{gettext("Ask the club head about the next session.")}</p>
    </.section>
  </div>
</Layouts.app>
