<Layouts.app
  flash={@flash}
  current_user={assigns[:current_user]}
  club={@club}
  club_role={@club_role}
  nav_session={@session}
  active="register"
>
  <.chrome crumbs={[{@club.name, ~p"/c/#{@club.uuid}"}]} here={gettext("Registered")}>
    <:seg href={~p"/l/#{@link.code}"} primary>{gettext("Open my session page")}</:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.banner kind={:good}>
      {gettext("You are registered as %{name}.", name: @link.user.name)}
    </.banner>

    <.section title={gettext("Your personal link")}>
      <div class="pad">
        <.copy_banner id="personal-link" url={@personal_url}>
          {gettext("Personal link")}
        </.copy_banner>
        <p :if={match?({:sent, _}, @mail)}>
          {gettext("We also sent it to %{email}.", email: elem(@mail, 1))}
        </p>
        <p :if={match?({:failed, _}, @mail)}>
          {gettext("We could not send it to %{email}. Copy it now.", email: elem(@mail, 1))}
        </p>
        <p>
          {gettext(
            "Keep this link — it IS your access: anyone with it acts as you. It opens your view of this session: your registration, the rooms, and (if you adjudicate) the ballot."
          )}
        </p>
      </div>
    </.section>
  </div>
</Layouts.app>
