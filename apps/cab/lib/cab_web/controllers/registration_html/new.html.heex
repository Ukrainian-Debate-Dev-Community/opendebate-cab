<Layouts.app
  flash={@flash}
  current_user={assigns[:current_user]}
  club={@club}
  club_role={@club_role}
  nav_session={@session}
  active="register"
>
  <.chrome
    crumbs={[{@club.name, ~p"/c/#{@club.uuid}"}]}
    here={gettext("Register — registration open")}
  >
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section :if={assigns[:current_user]} title={gettext("Registration")}>
      <.form_for
        id="register-form"
        action={~p"/r/#{@session.uuid}"}
        title={gettext("Register for %{session}", session: @state.event["name"])}
        description={
          gettext("Registering as %{name} — one registration per session.",
            name: @current_user.name || @current_user.username
          )
        }
        errors={@errors}
      >
        <:submit note={
          gettext(
            "You appear in this session's list right away; the club head seats you as a speaker or the adjudicator."
          )
        }>
          {gettext("Register")}
        </:submit>
      </.form_for>
    </.section>

    <.section :if={!assigns[:current_user]} title={gettext("Registration")}>
      <.form_for
        id="guest-register-form"
        action={~p"/r/#{@session.uuid}"}
        title={gettext("Register for %{session}", session: @state.event["name"])}
        description={
          gettext(
            "No account needed — you'll get a personal link that is your access to this session."
          )
        }
        errors={@errors}
      >
        <:block name={:name} type={:text} label={gettext("Your name")} required value={@name} />
        <:block
          :for={field <- @fields}
          name={answer_name(field)}
          type={block_type(field)}
          label={field["label"]}
          required={field["required"]}
          hint={field["hint"]}
          options={field["options"]}
          value={@answers[field["id"]]}
          input={input_type(field)}
          placeholder={placeholder(field)}
          prompt={prompt(field)}
        />
        <:submit note={
          gettext(
            "You appear in this session's list right away; the club head seats you as a speaker or the adjudicator."
          )
        }>
          {gettext("Register")}
        </:submit>
      </.form_for>
    </.section>
  </div>
</Layouts.app>
