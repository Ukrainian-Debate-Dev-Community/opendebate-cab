<Layouts.app
  flash={@flash}
  current_user={assigns[:current_user]}
  club={@club}
  club_role={@club_role}
  nav_session={@session}
  active="register"
>
  <.chrome
    crumbs={[{@club.name, ~p"/c/#{@club.uuid}"}]}
    here={gettext("Register — registration open")}
  >
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section :if={assigns[:current_user]} title={gettext("Registration")}>
      <.form_for
        id="register-form"
        action={~p"/r/#{@session.uuid}"}
        title={gettext("Register for %{session}", session: @state.event["name"])}
        logo={CabWeb.ClubProfile.logo_path(@club)}
        description={
          gettext("Registering as %{name} — one registration per session.",
            name: @current_user.name || @current_user.username
          )
        }
        errors={@errors}
      >
        <:submit note={
          gettext(
            "You appear in this session's list right away; the club head seats you as a speaker or the adjudicator."
          )
        }>
          {gettext("Register")}
        </:submit>
      </.form_for>
    </.section>

    <.section :if={!assigns[:current_user]} title={gettext("Registration")}>
      <.guest_form
        action={~p"/r/#{@session.uuid}"}
        title={gettext("Register for %{session}", session: @state.event["name"])}
        fields={@fields}
        logo={CabWeb.ClubProfile.logo_path(@club)}
        name={@name}
        answers={@answers}
        errors={@errors}
      />
    </.section>
  </div>
</Layouts.app>
