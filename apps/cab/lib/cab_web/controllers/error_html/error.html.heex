<!DOCTYPE html>
<html lang={Gettext.get_locale(CabWeb.Gettext)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{@heading} | cab</title>
    <script>
      try {
        const theme = localStorage.getItem("cab-theme")
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme
      } catch (_e) {}
    </script>
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
    <Ui.Components.tenant_theme />
  </head>
  <body>
    <main>
      <div class="error-card">
        <a href={~p"/"} class="wordmark">cab<.beta /></a>
        <h1>{@heading}</h1>
        <p>{@message}</p>
        <a href={~p"/"} class="btn-quiet">{gettext("Back to the clubs")}</a>
      </div>
    </main>
  </body>
</html>
