<Layouts.app flash={@flash} current_user={@current_user} active="account">
  <.chrome here={gettext("Account")}>
    <:seg form="account-form" primary>{gettext("Save")}</:seg>
    <:seg href={~p"/auth/logout"} quiet>{gettext("Sign out")}</:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section title={gettext("Profile")}>
      <.form_for id="account-form" action={~p"/account"}>
        <:block
          name={:name}
          type={:text}
          label={gettext("Display name")}
          value={@current_user.name}
          hint={gettext("Shown instead of your username on rosters and draws.")}
        />
        <:block
          name={:time_zone}
          type={:select}
          label={gettext("Time zone")}
          value={@current_user.time_zone || ""}
          options={[
            {gettext("This device's time zone"), ""}
            | Enum.map(Cab.Accounts.time_zones(), &{&1, &1})
          ]}
          hint={gettext("Session times show in this zone. cab keeps every time in UTC.")}
        />
      </.form_for>
      <div class="pad">
        <p>
          {gettext("Username:")} <b>{@current_user.username}</b>
          {if @current_user.email, do: ", #{@current_user.email}"}
        </p>
      </div>
    </.section>

    <.section title={gettext("Guest history")}>
      <.form_for
        id="claim-form"
        action={~p"/account/claim"}
        description={
          gettext(
            "Played as a guest? Paste that session's personal link to move its results onto this account."
          )
        }
      >
        <:block name={:link} type={:text} label={gettext("Personal link")} required />
        <:submit note={gettext("The link stops working once its history is yours.")}>
          {gettext("Add to my account")}
        </:submit>
      </.form_for>
    </.section>

    <.section title={gettext("Sign-in methods")}>
      <.table id="sign-in-methods" rows={[{"github", "GitHub"}, {"google", "Google"}]}>
        <:col :let={{_code, name}} label={gettext("Method")}>{name}</:col>
        <:col :let={{code, _name}} label={gettext("Status")}>
          {if Enum.any?(@identities, &(&1.provider == code)),
            do: gettext("linked"),
            else: gettext("not linked")}
        </:col>
        <:col :let={{code, name}}>
          <%= cond do %>
            <% not Enum.any?(@identities, &(&1.provider == code)) -> %>
              <.link href={~p"/account/link/#{code}"}>{gettext("link %{method}", method: name)}</.link>
            <% length(@identities) > 1 -> %>
              <.link href={~p"/account/unlink/#{code}"} method="post">{gettext("remove")}</.link>
            <% true -> %>
              <span class="mut">{gettext("your only sign-in")}</span>
          <% end %>
        </:col>
      </.table>
      <div class="pad">
        <p class="mut">
          {gettext(
            "Linking lets you sign in to this same account with either. Separate accounts are fine too: link only if you want them to be one. If the method you link already has its own cab account, you can merge the two."
          )}
        </p>
      </div>
    </.section>

    <.section title={gettext("Your data")} pad>
      <p>
        {gettext("Data requests or deletion:")} <a href="mailto:support@uadebate.com">support@uadebate.com</a>.
      </p>
    </.section>
  </div>
</Layouts.app>
