<Layouts.app flash={@flash} current_user={@current_user} active="account">
  <.chrome here="account">
    <:seg form="account-form" primary>Save</:seg>
    <:seg href={~p"/auth/logout"} quiet>Sign out</:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section title="Profile">
      <.form_for id="account-form" action={~p"/account"}>
        <:block
          name={:name}
          type={:text}
          label="Display name"
          value={@current_user.name}
          hint="Shown instead of your username on rosters and draws."
        />
      </.form_for>
      <div class="pad">
        <p>
          Username: <b>{@current_user.username}</b>
          {if @current_user.email, do: ", #{@current_user.email}"}
        </p>
      </div>
    </.section>

    <.section title="Guest history">
      <.form_for
        id="claim-form"
        action={~p"/account/claim"}
        description="Played as a guest? Paste that session's personal link to move its results onto this account."
      >
        <:block name={:link} type={:text} label="Personal link" required />
        <:submit note="The link stops working once its history is yours.">
          Add to my account
        </:submit>
      </.form_for>
    </.section>

    <.section title="Sign-in methods" pad>
      <%= if @identities == [] do %>
        Dev session — no provider linked.
      <% else %>
        Signed in with {Enum.map_join(@identities, ", ", & &1.provider)}.
      <% end %>
      <p>Google can be linked when it ships.</p>
      <p>
        Data requests or deletion: <a href="mailto:support@uadebate.com">support@uadebate.com</a>.
      </p>
    </.section>
  </div>
</Layouts.app>
