<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="club"
>
  <.chrome here={@club.name}>
    <:seg :if={@club_role in [:owner, :admin]} href={~p"/c/#{@club.uuid}/owner"}>
      {gettext("Edit club")}
    </:seg>
    <:seg :if={@club_role == :public and is_nil(@current_user)} href={~p"/signin"} primary>
      {gettext("Request to join")}
    </:seg>
    <:seg
      :if={@club_role == :public and @current_user}
      href={~p"/c/#{@club.uuid}/join"}
      primary
    >
      {gettext("Request to join")}
    </:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section title={gettext("About")} pad>
      <b id="club-name">{@club.name}</b>{if @club.city, do: ", #{@club.city}"}
      <p>
        {ngettext("%{count} member", "%{count} members", length(@members))}{if head_name(
                                                                                 @members
                                                                               ),
                                                                               do:
                                                                                 ", " <>
                                                                                   gettext(
                                                                                     "head: %{name}",
                                                                                     name:
                                                                                       head_name(
                                                                                         @members
                                                                                       )
                                                                                   )}
      </p>
      <p :if={@club.description}>{@club.description}</p>
      <p :if={@club.meeting_info}>{gettext("Meetings:")} {@club.meeting_info}</p>
      <p :if={@club.contacts}>{gettext("Contacts:")} {@club.contacts}</p>
      <p :if={CabWeb.ClubProfile.formats(@club.formats)}>
        {gettext("Format:")} {CabWeb.ClubProfile.formats(@club.formats)}
      </p>
      <p :if={CabWeb.ClubProfile.languages(@club.languages)}>
        {gettext("Language:")} {CabWeb.ClubProfile.languages(@club.languages)}
      </p>
      <p :if={CabWeb.ClubProfile.audiences(@club.audiences)}>
        {gettext("Audience:")} {CabWeb.ClubProfile.audiences(@club.audiences)}
      </p>
    </.section>

    <CabWeb.MemberHTML.archive_section club={@club} archive={@recent} />

    <.section title={gettext("Standings")} pad>
      {gettext("Standings for each session are under")}
      <.link href={~p"/c/#{@club.uuid}/standings/teams"}>{gettext("Standings")}</.link>.
    </.section>
  </div>
</Layouts.app>
