<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="club"
>
  <.chrome crumbs={[{@club.name, ~p"/c/#{@club.uuid}"}]} here={gettext("Join")}></.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section title={gettext("Join request")}>
      <.form_for
        id="join-request-form"
        action={~p"/c/#{@club.uuid}/join"}
        title={gettext("Join %{club}", club: @club.name)}
        description={gettext("The club head reads your answers before approving.")}
        errors={@errors}
      >
        <:block
          name={:message}
          type={:longtext}
          label={gettext("About me")}
          required
          maxlength={Cab.Clubs.Membership.max_lengths().message}
          value={@message}
          hint={gettext("Who you are and why you want to debate here.")}
        />
        <:block
          name={:contact}
          type={:text}
          label={gettext("Contact")}
          required
          maxlength={Cab.Clubs.Membership.max_lengths().contact}
          value={@contact}
          hint={gettext("Telegram, phone or email the head can reach you at.")}
        />
        <:submit note={gettext("The club head will review your request.")}>
          {gettext("Send request")}
        </:submit>
      </.form_for>
    </.section>
  </div>
</Layouts.app>
