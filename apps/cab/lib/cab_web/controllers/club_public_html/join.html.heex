<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="club"
>
  <.chrome crumbs={[{@club.name, ~p"/c/#{@club.uuid}"}]} here={gettext("Join")}></.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section title={gettext("Join request")}>
      <.form_for
        id="join-request-form"
        action={~p"/c/#{@club.uuid}/join"}
        title={gettext("Join %{club}", club: @club.name)}
        description={gettext("The club head reads your answers before approving.")}
        errors={@errors}
        guard
      >
        <:block
          :for={field <- @fields}
          name={answer_name(field)}
          type={block_type(field)}
          label={field_label(field)}
          required={field["required"]}
          hint={field["hint"]}
          options={field["options"]}
          value={@answers[field["id"]]}
          input={input_type(field)}
          placeholder={placeholder(field)}
          prompt={prompt(field)}
          maxlength={Core.Forms.max_length(field)}
        />
        <:submit note={
          gettext(
            "Your answers are also your defaults when you register for this club's sessions; change them on My page."
          )
        }>
          {gettext("Send request")}
        </:submit>
      </.form_for>
    </.section>
  </div>
</Layouts.app>
