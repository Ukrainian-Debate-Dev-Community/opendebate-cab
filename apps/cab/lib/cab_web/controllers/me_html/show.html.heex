<Layouts.app flash={@flash} current_user={@current_user} active="me">
  <.chrome here={gettext("My page")}></.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section title={gettext("Profile")} pad>
      <b>{@current_user.name || @current_user.username}</b>
      <span :if={@current_user.name}> ({@current_user.username})</span>
    </.section>

    <.section :if={@invitations != []} title={gettext("Invitations")}>
      <.table id="my-invitations" rows={@invitations}>
        <:col :let={invitation} label={gettext("Session")}>
          <.link href={~p"/c/#{invitation.session.club.uuid}/s/#{invitation.session.uuid}"}>
            {invitation.session.name || gettext("Session")}
          </.link>
          <.sub>{invitation.session.club.name}</.sub>
        </:col>
        <:col :let={invitation} label={gettext("Added by")}>
          {invitation.invited_by &&
            (invitation.invited_by.name || invitation.invited_by.username)}
        </:col>
        <:col :let={invitation}>
          <.link href={~p"/invitations/#{invitation.id}/accept"} method="post">{gettext("accept")}</.link>
        </:col>
        <:col :let={invitation}>
          <.link href={~p"/invitations/#{invitation.id}/decline"} method="post">{gettext(
            "decline"
          )}</.link>
        </:col>
      </.table>
      <div class="pad">
        <p class="mut">
          {gettext(
            "A club head added you to these sessions. Accept to see them on My page under your name; decline to have your name removed."
          )}
        </p>
      </div>
    </.section>

    <.section title={gettext("My clubs")}>
      <.table id="my-clubs" rows={@memberships} empty={gettext("You are not in any club yet.")}>
        <:col :let={m} label={gettext("Club")}>
          <.link href={~p"/c/#{m.club.uuid}"}>{m.club.name}</.link>
          <.sub>
            {if m.status == "approved", do: role_word(m.role), else: gettext("request pending")}{if m.club.city,
              do: ", #{m.club.city}"}
          </.sub>
        </:col>
        <:col :let={m} label={gettext("Next session")} class="st">
          <%= cond do %>
            <% m.status != "approved" -> %>
              —
            <% match?({%{scheduled_at: %DateTime{}}, :signup, _}, @tonight[m.club_id]) -> %>
              {gettext("registration open")},
              <.local_time
                at={elem(@tonight[m.club_id], 0).scheduled_at}
                as={:weekday_time}
              />
            <% true -> %>
              {tonight_words(@tonight[m.club_id])}
          <% end %>
        </:col>
      </.table>
    </.section>

    <.section :if={@schedule != []} title={gettext("My schedule")}>
      <.table id="my-schedule" rows={@schedule}>
        <:col :let={row} label={gettext("Session")}>
          <.link href={~p"/c/#{row.club.uuid}/s/#{row.session.uuid}"}>
            {row.club.name}
          </.link>
          <.sub :if={row.session.scheduled_at}>
            <.local_time at={row.session.scheduled_at} as={:short} />
          </.sub>
        </:col>
      </.table>
    </.section>

    <%= if @stats do %>
      <.section title={gettext("Stats")}>
        <.table id="me-stats" rows={[@stats]}>
          <:col :let={s} label={gettext("Ballots")}>
            {s["overview"]["total_ballots_received"]}
          </:col>
          <:col :let={s} label={gettext("Ranked debates")}>
            {s["overview"]["total_debates_ranked"]}
          </:col>
          <:col :let={s} label={gettext("Avg score")}>
            {s["overview"]["average_speaker_score"]}
          </:col>
          <:col :let={s} label={gettext("Highest")}>{s["overview"]["highest_score"]}</:col>
          <:col :let={s} label={gettext("Lowest")}>{s["overview"]["lowest_score"]}</:col>
          <:col :let={s} label={gettext("1st places")}>{s["placements"]["first_places"]}</:col>
          <:col :let={s} label={gettext("Win rate")}>
            {s["placements"]["win_rate_percentage"]}%
          </:col>
        </.table>
      </.section>
    <% else %>
      <.section title={gettext("Stats")} pad>
        {gettext("No logged debates yet — stats appear after your first scored round.")}
      </.section>
    <% end %>

    <.section title={gettext("History")}>
      <.table id="me-history" rows={@history} empty={gettext("No sessions played yet.")}>
        <:col :let={row} label={gettext("Session")}>
          <.link href={~p"/c/#{row.club_uuid}/s/#{row.session_uuid}"}>
            <.local_time at={row.date} as={:date} />
          </.link>
          <.sub>{row.club}</.sub>
        </:col>
        <:col :let={row} label={gettext("As")}>{role_word(row.role)}</:col>
        <:col :let={row} label={gettext("Result")} class="st">
          <%= cond do %>
            <% row.won -> %>
              <b>{gettext("won")}</b>
            <% row.role == "adjudicator" -> %>
              {gettext("adjudicated")}
            <% true -> %>
              {gettext("played")}
          <% end %>
        </:col>
      </.table>
    </.section>
  </div>
</Layouts.app>
