<Layouts.app flash={@flash} current_user={@current_user} active={!@guest && "me"}>
  <.chrome here={if @guest, do: gettext("Personal link"), else: gettext("My page")}></.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.page_head
      kicker={if @guest, do: gettext("Personal link"), else: gettext("My page")}
      title={@current_user.name || @current_user.username}
      lead={if @current_user.name && !@guest, do: "@" <> @current_user.username}
    />

    <%!-- a guest's hub: this link's sessions only, for now --%>
    <.banner :if={@guest} kind={:info}>
      {gettext(
        "This page is yours through your personal link: keep it, anyone with it acts as you. Sign in with an account to keep your results under your name."
      )}
    </.banner>

    <%!-- NOW: where the user sits in a running session - the room, the
         draw, the motion and its prep; the chair publishes it here --%>
    <.section
      :for={seat <- @seats}
      id={"now-#{seat.session.uuid}-#{seat.room["id"]}"}
      title={
        gettext("Now: %{room}, %{session}",
          room: room_label(seat.room),
          session: seat.session.name || seat.club.name
        )
      }
    >
      <div class="pad">
        <p>
          <b>{seat_words(seat, @current_user)}</b>
          <span class="mut">
            · {seat.club.name} · {format_name(Cab.Format.of(seat.session).key)}
          </span>
        </p>
      </div>
      <.table id={"now-draw-#{seat.room["id"]}"} rows={sorted_teams(seat.room)}>
        <:col :let={room_team} label={gettext("Side")} code>
          {side_code(room_team["position"], Cab.Format.of(seat.session))}
        </:col>
        <:col :let={room_team} label={gettext("Speakers")}>
          <%= if seat.room_team && room_team["id"] == seat.room_team["id"] do %>
            <b>{speaker_names(room_team)}</b>
            <.sub>{gettext("your team")}</.sub>
          <% else %>
            {speaker_names(room_team)}
          <% end %>
        </:col>
      </.table>
      <div class="pad">
        <p>{gettext("Adjudicator:")} <b>{judge_name(seat.room, seat.state.signups)}</b></p>
        <%= if motion = seat.room["Motion"] do %>
          <p class="kicker">{gettext("Motion")}</p>
          <p><b>{motion["motion_text"]}</b></p>
          <p :if={motion["infoslide"]}>{motion["infoslide"]}</p>
          <p :if={seat.room["prep_until"]} class="mut">
            <span
              id={"prep-#{seat.room["id"]}"}
              phx-hook="PrepClock"
              data-prep-deadline={seat.room["prep_until"]}
            >
              {gettext("prep")}
            </span>
          </p>
        <% else %>
          <p :if={seat.role == :speaker} class="mut">
            {gettext("The motion shows here the moment the adjudicator publishes it.")}
          </p>
        <% end %>
      </div>
      <%!-- the chair's motion, while the room has no ballot yet --%>
      <form
        :if={seat.role == :chair and seat.room["status"] in ["pending", "judging"]}
        id={"now-motion-#{seat.room["id"]}"}
        class="form"
        phx-submit="publish_motion"
      >
        <input type="hidden" name="session" value={seat.session.uuid} />
        <input type="hidden" name="room" value={seat.room["id"]} />
        <div class="f-block">
          <label class="q" for={"now-motion-text-#{seat.room["id"]}"}>
            {gettext("Motion")} <span class="req">*</span>
          </label>
          <input
            id={"now-motion-text-#{seat.room["id"]}"}
            type="text"
            name="motion_text"
            required
            maxlength={Cab.Sessions.max_lengths().motion_text}
            value={get_in(seat.room, ["Motion", "motion_text"])}
          />
        </div>
        <div class="f-block">
          <label class="q" for={"now-infoslide-#{seat.room["id"]}"}>{gettext("Infoslide")}</label>
          <textarea
            id={"now-infoslide-#{seat.room["id"]}"}
            name="infoslide"
            maxlength={Cab.Sessions.max_lengths().infoslide}
          >{get_in(seat.room, ["Motion", "infoslide"])}</textarea>
        </div>
        <div class="f-block">
          <label class="q" for={"now-keyword-#{seat.room["id"]}"}>{gettext("Keyword")}</label>
          <input
            id={"now-keyword-#{seat.room["id"]}"}
            type="text"
            name="keyword"
            maxlength={Cab.Sessions.max_lengths().keyword}
            value={get_in(seat.room, ["Motion", "keyword"])}
          />
        </div>
        <div class="f-submit">
          <button type="submit" class="btn-go">
            {if seat.room["Motion"], do: gettext("Update motion"), else: gettext("Publish motion")}
          </button>
          <span :if={!seat.room["Motion"]} class="note">
            {gettext("Publishing shows it to the room and starts 15 minutes of prep.")}
          </span>
        </div>
      </form>
      <%!-- the chair's ballot, once the motion is out and until it is in --%>
      <%= if seat.role == :chair and seat.room["Motion"] && seat.room["status"] in ["pending", "judging"] do %>
        <% {typed, error} = Map.get(@ballot_drafts, seat.room["id"], {nil, nil}) %>
        <div class="pad">
          <p class="kicker">{gettext("Ballot")}</p>
        </div>
        <CabWeb.Ui.ballot
          id={"now-ballot-#{seat.room["id"]}"}
          room={room_label(seat.room)}
          motion={seat.room["Motion"]["motion_text"]}
          teams={CabWeb.BallotForm.teams(seat.room, Cab.Format.of(seat.session), typed)}
          format={Cab.Format.of(seat.session)}
          error={error}
          submit="submit_ballot"
          fields={%{"session" => seat.session.uuid, "room" => seat.room["id"]}}
        />
        <div class="pad">
          <button type="submit" form={"now-ballot-#{seat.room["id"]}"} class="btn-go">
            {gettext("Submit ballot")}
          </button>
        </div>
      <% end %>
      <%!-- the ballot is in: the result, as the room's draw reads it --%>
      <div :if={seat.room["status"] in ["completed", "confirmed"]} class="pad">
        <p class="kicker">{gettext("Result")}</p>
        <p :for={room_team <- Enum.sort_by(sorted_teams(seat.room), &(&1["rank"] || 9))}>
          <b>{if room_team["rank"], do: ordinal(room_team["rank"]), else: "—"}</b>
          {side_code(room_team["position"], Cab.Format.of(seat.session))} · {speaker_names(
            room_team
          )} · {points_words(team_points(room_team))}
        </p>
      </div>
      <%!-- the ballot is in: the speaker's team gives feedback on the
           adjudicator before the head finishes; one per team --%>
      <%= case seat.feedback do %>
        <% {:sent, entry} -> %>
          <div class="pad">
            <p class="kicker">{gettext("Feedback on the adjudicator")}</p>
            <p>
              {gettext("Your team sent feedback:")}
              <b>{entry.accuracy} · {entry.reasoning}</b>
              <span class="mut">· {entry.discussion}</span>
            </p>
            <p class="mut">
              {gettext(
                "%{adjudicator} sees it, without your team's name, once the session is finished.",
                adjudicator: judge_name(seat.room, seat.state.signups)
              )}
            </p>
          </div>
        <% :open -> %>
          <% {typed, errors} = Map.get(@feedback_drafts, seat.room["id"], {%{}, %{}}) %>
          <.form_for
            id={"now-feedback-#{seat.room["id"]}"}
            action={
              ~p"/c/#{seat.club.uuid}/s/#{seat.session.uuid}/rooms/#{seat.room["id"]}/feedback"
            }
            submit_event="send_feedback"
            hidden={[{"session", seat.session.uuid}, {"room", seat.room["id"]}]}
            title={
              gettext("Feedback on %{name}", name: judge_name(seat.room, seat.state.signups))
            }
            description={
              gettext(
                "One feedback per team, before the club head finishes the session; the first one sent stays. The adjudicator sees it without your team's name once the session is finished."
              )
            }
            errors={errors}
          >
            <:block
              name={:accuracy}
              type={:int}
              label={Cab.Feedback.question_label("accuracy")}
              hint={gettext("A whole number from 1 to 10.")}
              min={1}
              max={10}
              required
              value={typed["accuracy"]}
            />
            <:block
              name={:reasoning}
              type={:int}
              label={Cab.Feedback.question_label("reasoning")}
              hint={gettext("A whole number from 1 to 10.")}
              min={1}
              max={10}
              required
              value={typed["reasoning"]}
            />
            <:block
              name={:discussion}
              type={:longtext}
              label={gettext("Discussion")}
              maxlength={Cab.Feedback.discussion_max()}
              hint={gettext("Explain your feedback.")}
              required
              value={typed["discussion"]}
            />
            <:submit>{gettext("Send feedback")}</:submit>
          </.form_for>
        <% nil -> %>
      <% end %>
    </.section>

    <%!-- registration: every session taking sign-ups in the user's
         clubs; registering (with the club's questions) and cancelling
         happen right here --%>
    <.section :if={@open_sessions != []} id="me-registration" title={gettext("Registration")}>
      <.table id="open-sessions" rows={@open_sessions}>
        <:col :let={row} label={gettext("Session")}>
          {row.session.name || row.club.name}
          <.sub>
            {row.club.name} · {format_name(Cab.Format.of(row.session).key)}
            <span :if={row.session.scheduled_at}>
              · <.local_time at={row.session.scheduled_at} as={:short} />
            </span>
          </.sub>
        </:col>
        <:col :let={row} label={gettext("Places")}>
          <%= cond do %>
            <% row.registered -> %>
              {gettext("you are registered")}
            <% Cab.Sessions.full?(row.session) -> %>
              {gettext("full")}
            <% left = Cab.Sessions.places_left(row.session) -> %>
              {ngettext("%{count} place left", "%{count} places left", left)}
            <% true -> %>
              {gettext("open")}
          <% end %>
        </:col>
        <:col :let={row}>
          <button
            :if={row.registered}
            type="button"
            class="btn-quiet btn-sm quiet"
            phx-click="cancel_registration"
            phx-value-session={row.session.uuid}
            data-confirm={gettext("Cancel your registration?")}
          >
            {gettext("Cancel")}
          </button>
          <button
            :if={!row.registered and !Cab.Sessions.full?(row.session)}
            type="button"
            class="btn-go btn-sm"
            phx-click="open_register"
            phx-value-session={row.session.uuid}
          >
            {gettext("Register")}
          </button>
        </:col>
      </.table>
      <.form_for
        :if={@registering}
        id="me-register-form"
        action={~p"/c/#{@registering.session.club.uuid}/register"}
        submit_event="register"
        hidden={[{"session", @registering.session.uuid}]}
        title={
          gettext("Register for %{session}",
            session: @registering.session.name || @registering.session.club.name
          )
        }
        description={
          if @registering.kind == :member,
            do:
              gettext(
                "Your saved answers are filled in. Changes here are for this session only; your defaults change on My page."
              ),
            else: gettext("You register with your account; one registration per session.")
        }
        errors={@registering.errors}
      >
        <:block
          :for={field <- @registering.fields}
          name={answer_name(field)}
          type={block_type(field)}
          label={field_label(field)}
          required={field["required"]}
          hint={field["hint"]}
          options={field["options"]}
          value={@registering.values[field["id"]]}
          input={input_type(field)}
          placeholder={placeholder(field)}
          prompt={prompt(field)}
          maxlength={Core.Forms.max_length(field)}
        />
        <:submit note={
          gettext(
            "You appear in this session's list right away; the club head seats you as a speaker or the adjudicator."
          )
        }>
          {gettext("Register")}
        </:submit>
      </.form_for>
    </.section>

    <%!-- one format's figures at a time, when there are several --%>
    <nav :if={!@guest && length(@stats_formats) > 1} class="pills" aria-label={gettext("Format")}>
      <.link
        :for={format <- @stats_formats}
        class={format == @stats_format && "on"}
        patch={~p"/me?#{[format: format.key]}"}
      >
        {format_name(format.key)}
      </.link>
    </nav>

    <%!-- the engine's figures as it reports them first, then counts of
         cab's own rows; on phones too: they are what this page is for --%>
    <.stats :if={!@guest} id="me-stats" phones>
      <:stat
        :if={@stats}
        label={gettext("Ranked debates")}
        note={
          ngettext(
            "%{count} ballot",
            "%{count} ballots",
            @stats["overview"]["total_ballots_received"] || 0
          )
        }
      >
        {@stats["overview"]["total_debates_ranked"]}
      </:stat>
      <:stat
        :if={@stats}
        label={gettext("Avg score")}
        note={
          gettext("highest %{high}, lowest %{low}",
            high: @stats["overview"]["highest_score"],
            low: @stats["overview"]["lowest_score"]
          )
        }
      >
        {fixed(@stats["overview"]["average_speaker_score"], 2)}
      </:stat>
      <:stat
        :if={@stats}
        label={gettext("Win rate")}
        note={
          ngettext(
            "%{count} first place",
            "%{count} first places",
            @stats["placements"]["first_places"] || 0
          )
        }
      >
        {fixed(@stats["placements"]["win_rate_percentage"], 1)}%
      </:stat>
      <:stat label={gettext("My clubs")}>{length(@memberships)}</:stat>
      <:stat label={gettext("Sessions")}>{length(@history)}</:stat>
    </.stats>
    <p :if={!@guest && !@stats} class="mut">
      {gettext("No logged debates yet — stats appear after your first scored round.")}
    </p>

    <div class="split">
      <div class="stack">
        <.section :if={@invitations != []} title={gettext("Invitations")}>
          <.table id="my-invitations" rows={@invitations}>
            <:col :let={invitation} label={gettext("Session")}>
              <.link href={~p"/c/#{invitation.session.club.uuid}/s/#{invitation.session.uuid}"}>
                {invitation.session.name || gettext("Session")}
              </.link>
              <.sub>{invitation.session.club.name}</.sub>
            </:col>
            <:col :let={invitation} label={gettext("Added by")}>
              {invitation.invited_by &&
                (invitation.invited_by.name || invitation.invited_by.username)}
            </:col>
            <:col :let={invitation}>
              <.link href={~p"/invitations/#{invitation.id}/accept"} method="post">{gettext(
                "accept"
              )}</.link>
            </:col>
            <:col :let={invitation}>
              <.link href={~p"/invitations/#{invitation.id}/decline"} method="post">{gettext(
                "decline"
              )}</.link>
            </:col>
          </.table>
          <div class="pad">
            <p class="mut">
              {gettext(
                "A club head added you to these sessions. Accept to see them on My page under your name; decline to have your name removed."
              )}
            </p>
          </div>
        </.section>
        <.section :if={@schedule != []} title={gettext("My schedule")}>
          <.table id="my-schedule" rows={@schedule}>
            <:col :let={row} label={gettext("Session")}>
              <.link href={~p"/c/#{row.club.uuid}/s/#{row.session.uuid}"}>
                {row.club.name}
              </.link>
              <.sub :if={row.session.scheduled_at}>
                <.local_time at={row.session.scheduled_at} as={:short} />
              </.sub>
            </:col>
          </.table>
        </.section>
        <.section
          :for={block <- @feedback_on_me}
          title={
            gettext("Feedback on your adjudication: %{session}",
              session: block.session.name || block.session.club.name
            )
          }
        >
          <div :if={block.average} class="pad">
            {gettext("Your average with the base vote:")} <b>{points_words(block.average)}</b>
            <span class="mut">{gettext("(5 counts as one vote)")}</span>
          </div>
          <.table id={"feedback-on-me-#{block.session.uuid}"} rows={block.entries}>
            <:col :let={entry} label={gettext("Room")}>
              {feedback_room_label(block.state, entry)}
            </:col>
            <:col :let={entry} label={gettext("Accuracy")} num>{entry.accuracy}</:col>
            <:col :let={entry} label={gettext("Reasoning")} num>{entry.reasoning}</:col>
            <:col :let={entry} label={gettext("Average")} num>{points_words(entry.score)}</:col>
            <:col :let={entry} label={gettext("Discussion")}>{entry.discussion}</:col>
          </.table>
        </.section>
        <.section :if={!@guest} title={gettext("History")}>
          <.table id="me-history" rows={@history} empty={gettext("No sessions played yet.")}>
            <:col :let={row} label={gettext("Session")}>
              <.link href={~p"/c/#{row.club_uuid}/s/#{row.session_uuid}"}>
                <.local_time at={row.date} as={:date} />
              </.link>
              <.sub>{row.club}</.sub>
            </:col>
            <:col :let={row} label={gettext("As")}>{role_word(row.role)}</:col>
            <:col :let={row} label={gettext("Result")} class="st">
              <%= cond do %>
                <% row.won -> %>
                  <b>{gettext("won")}</b>
                <% row.role == "adjudicator" -> %>
                  {gettext("adjudicated")}
                <% true -> %>
                  {gettext("played")}
              <% end %>
            </:col>
          </.table>
        </.section>
      </div>
      <div class="stack">
        <.section :if={!@guest} title={gettext("My clubs")}>
          <.table
            id="my-clubs"
            rows={@memberships}
            empty={gettext("You are not in any club yet.")}
          >
            <:col :let={m} label={gettext("Club")}>
              <.link href={~p"/c/#{m.club.uuid}"}>{m.club.name}</.link>
              <.sub>
                {if m.status == "approved",
                  do: role_word(m.role),
                  else: gettext("request pending")}{if m.club.city,
                  do: ", #{m.club.city}"}
              </.sub>
            </:col>
            <:col :let={m} label={gettext("Next session")} class="st">
              <%= cond do %>
                <% m.status != "approved" -> %>
                  —
                <% match?({%{scheduled_at: %DateTime{}}, :signup, _}, @tonight[m.club_id]) and
                    not Cab.Sessions.full?(elem(@tonight[m.club_id], 0)) -> %>
                  {gettext("registration open")},
                  <.local_time
                    at={elem(@tonight[m.club_id], 0).scheduled_at}
                    as={:weekday_time}
                  />
                <% true -> %>
                  {tonight_words(@tonight[m.club_id])}
              <% end %>
            </:col>
            <:col :let={m}>
              <.link
                :if={Cab.Clubs.member_fields(m.club) != []}
                href={~p"/me/clubs/#{m.club.uuid}/answers"}
              >
                {gettext("edit answers")}
              </.link>
            </:col>
          </.table>
        </.section>
      </div>
    </div>
  </div>
</Layouts.app>
