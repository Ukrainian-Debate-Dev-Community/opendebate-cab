<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="rooms"
>
  <.chrome
    crumbs={[
      {@club.name, ~p"/c/#{@club.uuid}"},
      {gettext("Session"), ~p"/c/#{@club.uuid}/s/#{@session.uuid}"}
    ]}
    here={gettext("Ballot %{room}", room: room_label(@room))}
  >
    <:seg form={"ballot-#{@room["id"]}"} primary>{gettext("Submit ballot")}</:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section title={gettext("Room %{room} ballot", room: room_label(@room))}>
      <Ui.ballot
        id={"ballot-#{@room["id"]}"}
        room={room_label(@room)}
        motion={@room["Motion"] && @room["Motion"]["motion_text"]}
        teams={@teams}
        error={@error}
        action={~p"/c/#{@club.uuid}/s/#{@session.uuid}/rooms/#{@room["id"]}/ballot"}
      />
    </.section>
  </div>
</Layouts.app>
