<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="rooms"
>
  <.chrome
    crumbs={[
      {@club.name, ~p"/c/#{@club.uuid}"},
      {@state.event["name"], ~p"/c/#{@club.uuid}/s/#{@session.uuid}"}
    ]}
    here={"Room #{room_label(@room)} — #{room_status_words(@room["status"])}"}
  >
    <:seg :if={@can_act && is_nil(@room["Motion"])} form={"room-motion-#{@room["id"]}"} primary>
      Publish motion
    </:seg>
    <:seg
      :if={@can_edit_ballot}
      href={~p"/c/#{@club.uuid}/s/#{@session.uuid}/rooms/#{@room["id"]}/ballot"}
      primary={@room["Motion"] != nil}
    >
      {if @room["status"] in ["completed", "confirmed"],
        do: "Edit ballot",
        else: "Fill ballot"}
    </:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section title="Draw">
      <.table id={"room-#{@room["id"]}-draw"} rows={sorted_teams(@room)}>
        <:col :let={room_team} label="Side" code>{side_code(room_team["position"])}</:col>
        <:col :let={room_team} label="Team">{get_in(room_team, ["Team", "name"])}</:col>
        <:col :let={room_team} label="Speakers">{speaker_names(room_team)}</:col>
      </.table>
      <div class="pad">Adjudicator: <b>{judge_name(@room, @state.signups)}</b></div>
    </.section>

    <.section :if={@room["Motion"]} title="Motion" pad>
      <b id="room-motion-text">{@room["Motion"]["motion_text"]}</b>
      <p :if={@room["Motion"]["infoslide"]}>{@room["Motion"]["infoslide"]}</p>
      <p :if={@room["Motion"]["keyword"]} class="mut">
        keyword: {@room["Motion"]["keyword"]}
      </p>
      <p :if={@room["prep_until"]} class="mut">
        <span id="prep-clock" phx-hook="PrepClock" data-prep-deadline={@room["prep_until"]}>
          {@room["prep_minutes"]} minutes of prep
        </span>
      </p>
    </.section>
    <.section :if={!@room["Motion"] && !@can_act} title="Motion" pad>
      Not set yet — the adjudicator sets it when the room begins.
    </.section>
    <.section
      :if={@can_act && @room["status"] in ["pending", "judging"]}
      title={if @room["Motion"], do: "Edit motion", else: "Motion"}
    >
      <.form_for
        id={"room-motion-#{@room["id"]}"}
        action={~p"/c/#{@club.uuid}/s/#{@session.uuid}/rooms/#{@room["id"]}/motion"}
        title={if @room["Motion"], do: "Edit this room's motion", else: "This room's motion"}
        description="Everyone in the room sees it right away."
      >
        <:block
          name={:motion_text}
          type={:text}
          label="Motion"
          required
          value={get_in(@room, ["Motion", "motion_text"])}
        />
        <:block
          name={:infoslide}
          type={:longtext}
          label="Infoslide"
          hint="Optional context read before prep."
          value={get_in(@room, ["Motion", "infoslide"])}
        />
        <:block
          name={:keyword}
          type={:text}
          label="Keyword"
          hint="Optional tag for finding the motion later."
          value={get_in(@room, ["Motion", "keyword"])}
        />
        <:block
          name={:prep_minutes}
          type={:int}
          label="Prep timer, minutes"
          min={1}
          max={60}
          placeholder="no timer"
          hint="Optional. A new length starts the clock now; the same one keeps it running."
          value={@room["prep_minutes"]}
        />
        <:submit note="Visible to everyone in the room right away.">
          {if @room["Motion"], do: "Update motion", else: "Publish motion"}
        </:submit>
      </.form_for>
    </.section>

    <.section title="Share this room">
      <div
        class="pad sharecard"
        id={"room-card-#{@room["id"]}"}
        phx-hook="RoomCard"
        data-card={room_card(@state, @room, @session, @club)}
      >
        <canvas id={"room-card-canvas-#{@room["id"]}"} role="img" aria-label="Room card preview"></canvas>
        <div class="sharebtns">
          <button type="button" class="copy" data-card-copy>Copy image</button>
          <button type="button" class="copy" data-card-save>Save image</button>
          <span class="sharemsg" aria-live="polite"></span>
        </div>
      </div>
    </.section>
  </div>
</Layouts.app>
