<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="rooms"
>
  <.chrome
    crumbs={[
      {@club.name, ~p"/c/#{@club.uuid}"},
      {@state.event["name"], ~p"/c/#{@club.uuid}/s/#{@session.uuid}"}
    ]}
    here={
      gettext("Room %{room} — %{status}",
        room: room_label(@room),
        status: room_status_words(@room["status"])
      )
    }
  >
    <:seg :if={@can_act && is_nil(@room["Motion"])} form={"room-motion-#{@room["id"]}"} primary>
      {gettext("Publish motion")}
    </:seg>
    <:seg
      :if={@can_act && @room["Motion"] && @room["status"] in ["pending", "judging"]}
      form={"room-motion-#{@room["id"]}"}
    >
      {gettext("Update motion")}
    </:seg>
    <:seg
      :if={@can_edit_ballot}
      href={~p"/c/#{@club.uuid}/s/#{@session.uuid}/rooms/#{@room["id"]}/ballot"}
      primary={@room["Motion"] != nil}
    >
      {if @room["status"] in ["completed", "confirmed"],
        do: gettext("Edit ballot"),
        else: gettext("Fill ballot")}
    </:seg>
    <:seg
      :if={@give_feedback}
      href={~p"/c/#{@club.uuid}/s/#{@session.uuid}/rooms/#{@room["id"]}/feedback"}
      primary={not @can_act and not @can_edit_ballot}
    >
      {gettext("Give feedback — %{room}", room: room_label(@room))}
    </:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section title={gettext("Draw")}>
      <.table id={"room-#{@room["id"]}-draw"} rows={sorted_teams(@room)}>
        <:col :let={room_team} label={gettext("Side")} code>
          {side_code(room_team["position"])}
        </:col>
        <:col :let={room_team} label={gettext("Team")}>
          {get_in(room_team, ["Team", "name"])}
        </:col>
        <:col :let={room_team} :if={!ballot_in?(@room)} label={gettext("Speakers")}>
          {speaker_names(room_team)}
        </:col>
        <:col :let={room_team} :if={ballot_in?(@room)} label={gettext("Speakers")}>
          <div :for={speech <- speeches(room_team)} class="speech">
            {speech.name}<span :if={speech.iron} class="mut">{gettext("(iron)")}</span>
            <b class="pts">{points_words(speech.points)}</b>
          </div>
        </:col>
        <:col :let={room_team} :if={ballot_in?(@room)} label={gettext("Points")} num>
          {points_words(team_points(room_team))}
        </:col>
        <:col :let={room_team} :if={ballot_in?(@room)} label={gettext("Place")} num>
          {if room_team["rank"], do: ordinal(room_team["rank"]), else: "—"}
        </:col>
      </.table>
      <div class="pad">{gettext("Adjudicator:")} <b>{judge_name(@room, @state.signups)}</b></div>
    </.section>

    <.section
      :if={@room["Motion"] && !(@can_act && @room["status"] in ["pending", "judging"])}
      title={gettext("Motion")}
      pad
    >
      <b id="room-motion-text">{@room["Motion"]["motion_text"]}</b>
      <p :if={@room["Motion"]["infoslide"]}>{@room["Motion"]["infoslide"]}</p>
      <p :if={@room["Motion"]["keyword"]} class="mut">
        {gettext("keyword: %{keyword}", keyword: @room["Motion"]["keyword"])}
      </p>
      <p :if={@room["prep_until"]} class="mut">
        <span id="prep-clock" phx-hook="PrepClock" data-prep-deadline={@room["prep_until"]}>
          {gettext("prep")}
        </span>
      </p>
    </.section>
    <.section :if={!@room["Motion"] && !@can_act} title={gettext("Motion")} pad>
      {gettext("Not set yet — the adjudicator sets it when the room begins.")}
    </.section>
    <.section
      :if={@can_act && @room["status"] in ["pending", "judging"]}
      title={gettext("Motion")}
    >
      <div :if={@room["prep_until"]} class="pad mut prep-line">
        <span id="prep-clock" phx-hook="PrepClock" data-prep-deadline={@room["prep_until"]}>
          {gettext("prep")}
        </span>
      </div>
      <.form_for
        id={"room-motion-#{@room["id"]}"}
        action={~p"/c/#{@club.uuid}/s/#{@session.uuid}/rooms/#{@room["id"]}/motion"}
        description={
          if @room["Motion"],
            do: nil,
            else: gettext("Publishing shows it to the room and starts 15 minutes of prep.")
        }
      >
        <:block
          name={:motion_text}
          type={:text}
          label={gettext("Motion")}
          required
          maxlength={Cab.Sessions.max_lengths().motion_text}
          value={get_in(@room, ["Motion", "motion_text"])}
        />
        <:block
          name={:infoslide}
          type={:longtext}
          label={gettext("Infoslide")}
          maxlength={Cab.Sessions.max_lengths().infoslide}
          hint={gettext("Optional context read before prep.")}
          value={get_in(@room, ["Motion", "infoslide"])}
        />
        <:block
          name={:keyword}
          type={:text}
          label={gettext("Keyword")}
          hint={gettext("Optional tag for finding the motion later.")}
          maxlength={Cab.Sessions.max_lengths().keyword}
          value={get_in(@room, ["Motion", "keyword"])}
        />
        <:block
          name={:prep_until}
          type={:text}
          label={gettext("Prep ends at")}
          placeholder={gettext("HH:MM")}
          hint={
            if @room["Motion"],
              do:
                gettext(
                  "Change the time to move the end of prep; left empty, it is 15 minutes from now."
                ),
              else: gettext("Set to 15 minutes from publishing, or type a time.")
          }
          value={@room["prep_until"]}
        />
      </.form_for>
    </.section>

    <.section title={gettext("Share this room")}>
      <div
        class="pad sharecard"
        id={"room-card-#{@room["id"]}"}
        phx-hook="RoomCard"
        data-card={room_card(@state, @room, @session, @club)}
      >
        <p class="sharehint">
          {gettext("Click the picture or the text to copy it, then paste it into the chat.")}
          <span class="sharemsg" aria-live="polite"></span>
        </p>
        <div class="sharecols">
          <canvas
            id={"room-card-canvas-#{@room["id"]}"}
            data-card-image
            role="button"
            tabindex="0"
            aria-label={gettext("The room as a picture: copy it")}
            title={gettext("Copy the picture")}
          ></canvas>
          <pre
            id={"room-card-text-#{@room["id"]}"}
            class="sharetext"
            data-card-text
            role="button"
            tabindex="0"
            aria-label={gettext("The room as text: copy it")}
            title={gettext("Copy the text")}
          ></pre>
        </div>
      </div>
    </.section>
  </div>
</Layouts.app>
