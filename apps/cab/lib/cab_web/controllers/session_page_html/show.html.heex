<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="rooms"
>
  <.chrome
    crumbs={[{@club.name, ~p"/c/#{@club.uuid}"}]}
    here={"#{@state.event["name"]} — #{stage_words(@state.stage)}"}
  >
    <:seg
      :if={@state.stage == :signup && is_nil(@my_signup)}
      href={~p"/r/#{@session.uuid}"}
      primary
    >
      {gettext("Register")}
    </:seg>
    <:seg
      :if={@state.stage == :signup && @my_signup}
      href={~p"/c/#{@club.uuid}/s/#{@session.uuid}/signups/#{@my_signup["id"]}/remove"}
      method="post"
      quiet
    >
      {gettext("Cancel my registration")}
    </:seg>
    <:seg
      :if={@my_ballot_room}
      href={~p"/c/#{@club.uuid}/s/#{@session.uuid}/rooms/#{@my_ballot_room["id"]}/ballot"}
      primary
    >
      {gettext("Fill ballot — %{room}", room: room_label(@my_ballot_room))}
    </:seg>
    <:seg
      :if={@feedback_room}
      href={~p"/c/#{@club.uuid}/s/#{@session.uuid}/rooms/#{@feedback_room["id"]}/feedback"}
      primary={is_nil(@my_ballot_room)}
    >
      {gettext("Give feedback — %{room}", room: room_label(@feedback_room))}
    </:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.banner :if={@state.stage != :done && @my_signup} kind={:good}>
      {gettext("You are registered for this session.")}
    </.banner>
    <.banner :if={@state.stage in [:closed, :running]} kind={:info}>
      {gettext("Registration is closed for this session.")}
    </.banner>

    <.section title={gettext("Session")} pad>
      <b id="session-name">{@state.event["name"]}</b>
      <p>
        <.local_time
          at={@session.scheduled_at || @session.inserted_at}
          as={if @session.scheduled_at, do: :datetime, else: :date}
        />
      </p>
      <p id="session-short-link">
        {gettext("Short link:")} <code>{bare_url(Cab.Sessions.short_url(@session))}</code>
        <.copy text={Cab.Sessions.short_url(@session)} />
      </p>
      <%= case @winners do %>
        <% [] -> %>
        <% [{_room, name}] -> %>
          <p>{gettext("Winner:")} <b>{name}</b></p>
        <% several -> %>
          <p>{gettext("Winners:")}</p>
          <p :for={{room, name} <- several}>{room_label(room)}: <b>{name}</b></p>
      <% end %>
    </.section>

    <%= case @state.stage do %>
      <% stage when stage in [:signup, :closed] -> %>
        <.section title={gettext("Who's registered")}>
          <.table
            id="session-signups"
            rows={@state.signups}
            empty={gettext("Nobody registered yet.")}
          >
            <:col :let={participant} label={gettext("Name")}>{participant["display_name"]}</:col>
          </.table>
        </.section>
      <% :running -> %>
        <.banner :if={my_room_motion(@state, @my_room_id)} kind={:info}>
          {gettext("Room %{room} motion:", room: my_room_label(@state, @my_room_id))}
          <b>{my_room_motion(@state, @my_room_id)}</b>
        </.banner>

        <.section title={gettext("Rooms")}>
          <.table
            id="session-rooms"
            rows={@state.rooms}
            row_class={fn room -> room["id"] == @my_room_id && "me" end}
          >
            <:col :let={room} class="rank">
              <.link href={~p"/c/#{@club.uuid}/s/#{@session.uuid}/rooms/#{room["id"]}"}>
                {room_label(room)}
              </.link>
            </:col>
            <:col
              :let={room}
              :for={{label, position, side_class} <- sides()}
              label={label}
              class={"side #{side_class}"}
            >
              {team_label(room, position)}
            </:col>
            <:col :let={room} label={gettext("Adjudicator")}>
              <%= if @current_user && Cab.Sessions.room_chair?(room, @current_user) do %>
                <b>{gettext("you")}</b>
              <% else %>
                {judge_name(room, @state.signups)}
              <% end %>
            </:col>
            <:col :let={room} label={gettext("Status")} class="st">
              {room_words(room)}
            </:col>
          </.table>
        </.section>
      <% :done -> %>
        <.section :if={@on_me != []} title={gettext("Feedback on your adjudication")}>
          <div :if={@my_average} class="pad">
            {gettext("Your average with the base vote:")} <b>{points_words(@my_average)}</b>
            <span class="mut">{gettext("(5 counts as one vote)")}</span>
          </div>
          <.table id="feedback-on-me" rows={@on_me}>
            <:col :let={entry} label={gettext("Room")}>{feedback_room_label(@state, entry)}</:col>
            <:col :let={entry} label={gettext("Accuracy")} num>{entry.accuracy}</:col>
            <:col :let={entry} label={gettext("Reasoning")} num>{entry.reasoning}</:col>
            <:col :let={entry} label={gettext("Average")} num>{points_words(entry.score)}</:col>
            <:col :let={entry} label={gettext("Discussion")}>{entry.discussion}</:col>
          </.table>
        </.section>

        <.section :if={@state.rooms == []} title={gettext("Rooms")} pad>
          {gettext("This session finished without rooms.")}
        </.section>

        <%= for room <- @state.rooms do %>
          <.section title={gettext("Room %{room}", room: room_label(room))}>
            <div class="pad">
              {gettext("Motion:")}
              <b>{(room["Motion"] && room["Motion"]["motion_text"]) || "—"}</b>
            </div>
            <.table id={"room-#{room["id"]}-teams"} rows={sorted_teams(room)}>
              <:col :let={room_team} label={gettext("Side")} code>
                {side_code(room_team["position"])}
              </:col>
              <:col :let={room_team} label={gettext("Speakers")}>{speaker_names(room_team)}</:col>
              <:col :let={room_team} label={gettext("Result")} class="st">
                <%= if room["status"] in ["completed", "confirmed"] && room_team["rank"] do %>
                  <%= if room_team["rank"] == 1 do %>
                    <b>{gettext("won")}</b>
                  <% else %>
                    {ordinal(room_team["rank"])}
                  <% end %>
                <% else %>
                  —
                <% end %>
              </:col>
            </.table>
          </.section>
        <% end %>
    <% end %>
  </div>
</Layouts.app>
