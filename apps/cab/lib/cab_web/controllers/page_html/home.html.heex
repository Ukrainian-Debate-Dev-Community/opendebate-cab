<Layouts.app flash={@flash} current_user={@current_user} active="clubs">
  <.chrome here={gettext("Debate clubs of Ukraine")}></.chrome>
  <div class="pbody">
    <.flash_banners flash={@flash} />
    <.banner
      :if={@open_club}
      kind={:info}
      href={~p"/c/#{@open_club.uuid}"}
      link={gettext("Open")}
    >
      {gettext("%{club}: a session is open.", club: @open_club.name)}
    </.banner>
    <.banner :if={@invitations > 0} kind={:info} href={~p"/me"} link={gettext("My page")}>
      {ngettext(
        "A club head added you to a session.",
        "Club heads added you to %{count} sessions.",
        @invitations
      )} {gettext("Accept or decline on My page.")}
    </.banner>

    <div :if={!@current_user} class="welcome" id="welcome">
      <h2>{gettext("Welcome to")} <span class="brand-script">cab</span></h2>
      <p>
        {gettext(
          "The home of Ukrainian debate clubs: find a club, register for a session, debate — and follow standings and your own results in one place. Free for every Ukrainian club, run by the Debate Federation of Ukraine."
        )}
      </p>
      <p class="mut">
        {gettext("Registering for a session needs no account — the club shares one link.")}
        <.link href={~p"/signin"}>{gettext("Sign in")}</.link>
        {gettext("to keep your history, schedule and personal stats.")}
      </p>
    </div>

    <.section title={gettext("Clubs")}>
      <.table
        id="clubs-directory"
        rows={@clubs}
        empty={gettext("No clubs here yet.")}
      >
        <:col :let={club} label={gettext("Club")}>
          <span class="club-name">
            <.club_logo club={club} />
            <.link href={~p"/c/#{club.uuid}"}>{club.name}</.link>
          </span>
        </:col>
        <:col :let={club} label={gettext("City")}>{club.city}</:col>
        <:col :let={club} label={gettext("Format")}>
          {CabWeb.ClubProfile.formats(club.formats, club.format_other)}
        </:col>
        <:col :let={club} label={gettext("Members")} num>{@member_counts[club.id] || 0}</:col>
        <:col :let={club} label={gettext("Next session")} class="st">
          <%= case @tonight[club.id] do %>
            <% nil -> %>
              {gettext("not planned yet")}
            <% {session, :signup, _rooms} -> %>
              <span class="next-reg">
                <.local_time
                  :if={session.scheduled_at}
                  at={session.scheduled_at}
                  as={:weekday_time}
                />
                <.link href={~p"/c/#{club.uuid}" <> "#register"} class="btn-quiet btn-sm">
                  {gettext("Register")}
                </.link>
              </span>
            <% {_session, :closed, _rooms} -> %>
              {gettext("registration closed")}
            <% {session, :running, _rooms} -> %>
              {gettext("running")} —
              <.link href={~p"/c/#{club.uuid}/s/#{session.uuid}"}>
                {gettext("watch rooms")}
              </.link>
          <% end %>
        </:col>
      </.table>
    </.section>
  </div>
</Layouts.app>
