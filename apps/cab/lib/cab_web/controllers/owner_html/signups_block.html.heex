<.section title={"People (#{signed_up_counts(@state.signups)})"}>
  <div :if={@links != []} class="pad">
    <p>A guest's personal link is their only access — share it only with them.</p>
  </div>
  <.table id="session-people" rows={@state.signups} empty="Nobody signed up yet.">
    <:col :let={participant} label="Name">
      {participant["display_name"]}
      <.sub>{person_kind(participant, @links, @members, @invitations)}</.sub>
    </:col>
    <:col :let={participant} label="Seat">{seat_words(participant, @state, @draft)}</:col>
    <:col :let={participant} label="Personal link" code>
      {if link = guest_link(participant, @links), do: url(~p"/l/#{link.code}"), else: "—"}
    </:col>
    <:col :let={participant}>
      <.copy :if={link = guest_link(participant, @links)} text={url(~p"/l/#{link.code}")} />
    </:col>
    <:col :let={participant}>
      <.link
        :if={removable?(participant, @state)}
        href={
          ~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/signups/#{participant["id"]}/remove"
        }
        method="post"
      >
        remove
      </.link>
    </:col>
  </.table>
</.section>
