<.section title={gettext("People (%{count})", count: signed_up_counts(@state.signups))}>
  <div :if={@links != []} class="pad">
    <p>{gettext("A guest's personal link is their only access — share it only with them.")}</p>
    <.form for={%{}} id="send-guest-link" class="send-link" phx-submit="send_link">
      <select name="link" aria-label={gettext("Guest")}>
        <option :for={link <- @links} value={link.id}>{link.user.name}</option>
      </select>
      <input
        type="email"
        name="email"
        required
        autocomplete="off"
        placeholder={gettext("their e-mail address")}
        aria-label={gettext("E-mail address")}
      />
      <button type="submit" class="btn-quiet">{gettext("Send link")}</button>
    </.form>
  </div>
  <%!-- batch actions over the checked rows; the selection is the LiveView's --%>
  <div
    :if={@state.signups != []}
    id="people-batch"
    class={["batch", MapSet.size(@selected) == 0 && "idle"]}
  >
    <label class="pick-all">
      <input
        type="checkbox"
        class="pick"
        phx-click="select_all"
        checked={all_selected?(@state.signups, @selected)}
      />
      {gettext("Select all")}
    </label>
    <%= if MapSet.size(@selected) > 0 do %>
      <span class="count">
        {ngettext("%{count} selected", "%{count} selected", MapSet.size(@selected))}
      </span>
      <button
        type="button"
        id="copy-links"
        class="btn-quiet"
        phx-hook="CopyLinks"
        data-links={batch_links(@state.signups, @links, @selected).text}
      >
        {gettext("Copy links")}
      </button>
      <button type="button" class="btn-quiet quiet" phx-click="confirm_remove">
        {gettext("Remove selected")}
      </button>
      <button type="button" class="btn-link" phx-click="clear_selection">
        {gettext("Clear")}
      </button>
    <% end %>
  </div>
  <div :if={@confirm_remove && MapSet.size(@selected) > 0} id="confirm-remove" class="banner bad flush">
    <span>
      {ngettext(
        "Remove %{count} person from %{session}?",
        "Remove %{count} people from %{session}?",
        MapSet.size(@selected),
        session: @state.event["name"]
      )}
    </span>
    <span class="actions">
      <button type="button" class="btn-quiet quiet" phx-click="remove_selected">
        {gettext("Remove")}
      </button>
      <button type="button" class="btn-link" phx-click="cancel_remove">
        {gettext("Cancel")}
      </button>
    </span>
  </div>
  <div :if={@refused != []} id="remove-refused" class="banner bad flush refused">
    <span>
      {ngettext(
        "%{count} person could not be removed:",
        "%{count} people could not be removed:",
        length(@refused)
      )}
      <ul>
        <li :for={{name, reason} <- @refused}>{name}: {reason}</li>
      </ul>
    </span>
  </div>
  <.table id="session-people" rows={@state.signups} empty={gettext("Nobody registered yet.")}>
    <:head>
      <input
        type="checkbox"
        class="pick"
        phx-click="select_all"
        checked={all_selected?(@state.signups, @selected)}
        aria-label={gettext("Select all")}
      />
    </:head>
    <:col :let={participant} label={gettext("Name")}>
      <input
        type="checkbox"
        class="pick"
        phx-click="toggle"
        phx-value-id={participant["id"]}
        checked={MapSet.member?(@selected, participant["id"])}
        aria-label={gettext("Select %{name}", name: participant["display_name"])}
      />
      {participant["display_name"]}
      <.sub>{person_kind(participant, @links, @members, @invitations)}</.sub>
      <%!-- the guest's answers to the club's registration form: head only --%>
      <CabWeb.FormComponents.form_answers answers={guest_answers(participant, @links)} />
    </:col>
    <:col :let={participant} label={gettext("Seat")}>
      {seat_words(participant, @state, @draft)}
    </:col>
    <:col :let={participant} label={gettext("Personal link")} code wide_only>
      {if link = guest_link(participant, @links), do: url(~p"/l/#{link.code}"), else: "—"}
    </:col>
    <:col :let={participant}>
      <.copy :if={link = guest_link(participant, @links)} text={url(~p"/l/#{link.code}")} />
    </:col>
    <:col :let={participant}>
      <.link
        :if={removable?(participant, @state)}
        href={
          ~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/signups/#{participant["id"]}/remove"
        }
        method="post"
      >
        {gettext("remove")}
      </.link>
    </:col>
  </.table>
</.section>
