<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="sessions"
>
  <.chrome
    crumbs={[
      {@club.name, ~p"/c/#{@club.uuid}"},
      {gettext("Club"), ~p"/c/#{@club.uuid}/owner"},
      {@name || gettext("Spar"), ~p"/c/#{@club.uuid}/owner/s/#{@current.uuid}"}
    ]}
    here={gettext("Delete spar")}
  >
    <:seg href={~p"/c/#{@club.uuid}/owner/s/#{@current.uuid}"}>
      {gettext("Keep the spar")}
    </:seg>
  </.chrome>

  <div class="pbody">
    <.page_head kicker={gettext("Delete spar")} title={@name || gettext("Spar")} />

    <div class="narrow">
      <.section title={gettext("Delete spar")}>
        <.form_for
          id="delete-session-form"
          action={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/cancel"}
          title={gettext("Delete %{session}?", session: @name || gettext("this spar"))}
          description={
            gettext(
              "Nobody has signed up, so the spar can go: it disappears from the club, and its registration link and short link stop working. This cannot be undone."
            )
          }
        >
          <:submit quiet>{gettext("Delete spar")}</:submit>
        </.form_for>
      </.section>
    </div>
  </div>
</Layouts.app>
