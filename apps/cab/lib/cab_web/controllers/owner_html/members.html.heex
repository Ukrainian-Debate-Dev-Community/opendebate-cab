<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="members"
>
  <.chrome crumbs={[{@club.name, ~p"/c/#{@club.uuid}"}]} here={gettext("Members")}></.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section title={gettext("Join requests (%{count})", count: length(@join_requests))}>
      <.table
        id="join-requests"
        rows={@join_requests}
        row_id={&"join-request-#{&1.id}"}
        empty={gettext("No pending requests.")}
      >
        <:col :let={request} label={gettext("Who")}>
          {request.user.username}
          <.sub :if={request.user.name}>{request.user.name}</.sub>
        </:col>
        <:col :let={request} label={gettext("About them")}>
          {request.message || "—"}
          <.sub :if={request.contact}>
            {gettext("contact: %{contact}", contact: request.contact)}
          </.sub>
        </:col>
        <:col :let={request} label={gettext("Requested")}>
          <.local_time at={request.inserted_at} as={:date} />
        </:col>
        <:col :let={request}>
          <.link
            href={~p"/c/#{@club.uuid}/owner/join-requests/#{request.id}/approve"}
            method="post"
          >
            {gettext("approve")}
          </.link>
        </:col>
        <:col :let={request}>
          <.link
            href={~p"/c/#{@club.uuid}/owner/join-requests/#{request.id}/decline"}
            method="post"
          >
            {gettext("decline")}
          </.link>
        </:col>
      </.table>
    </.section>

    <.section title={gettext("Members (%{count})", count: length(@members))}>
      <.table id="members-list" rows={@members} empty={gettext("No members yet.")}>
        <:col :let={membership} label={gettext("Member")}>
          {membership.user.username}
          <.sub :if={membership.user.name}>{membership.user.name}</.sub>
        </:col>
        <:col :let={membership} label={gettext("Role")}>{role_word(membership.role)}</:col>
        <:col :let={membership} label={gettext("Since")}>
          <.local_time at={membership.inserted_at} as={:date} />
        </:col>
        <:col :let={membership}>
          <.link
            :if={membership.role != "head"}
            href={~p"/c/#{@club.uuid}/owner/members/#{membership.user_id}/remove"}
            method="post"
          >
            {gettext("remove")}
          </.link>
        </:col>
      </.table>
    </.section>
  </div>
</Layouts.app>
