<%= case @state.stage do %>
  <% :signup -> %>
    <.section title={
      gettext("Allocation — %{count} room(s), count automatic",
        count: Cab.Sessions.room_count(@state.signups)
      )
    }>
      <div class="pad">
        <p>
          {gettext(
            "A room seats nine (eight speakers and an adjudicator), so the room count follows the sign-ups;"
          )}
          <b>{gettext("nobody is placed automatically")}</b>
          {gettext("— drag people from the tray into the slots, then")}
          <b>{gettext("Start session")}</b>
          {gettext("closes registration and opens these rooms.")}
        </p>
      </div>
      <.allocator
        rooms={Cab.Sessions.room_count(@state.signups)}
        people={people(@state.signups)}
        draft={@draft}
        form_id="allocator-form"
        submit="start"
      />
    </.section>
  <% :closed -> %>
    <.section title={
      gettext("Allocation — %{count} room(s), count automatic",
        count: Cab.Sessions.room_count(@state.signups)
      )
    }>
      <div class="pad">
        <p>
          {attendance_line(@state.signups)} <b>{gettext("Nobody is placed automatically")}</b>
          {gettext("— drag people from the tray into the slots.")}
        </p>
      </div>
      <.allocator
        rooms={Cab.Sessions.room_count(@state.signups)}
        people={people(@state.signups)}
        draft={@draft}
        form_id="allocator-form"
        submit="make_rooms"
      />
    </.section>
  <% _running_or_done -> %>
    <.section title={gettext("Rooms")}>
      <.table
        id="session-rooms"
        rows={@state.rooms}
        row_href={fn room -> ~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}" end}
      >
        <:col :let={room} class="rank">
          <.link href={~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}"}>
            {room_label(room)}
          </.link>
        </:col>
        <:col
          :let={room}
          :for={{label, position, side_class} <- sides()}
          label={label}
          class={"side #{side_class}"}
        >
          {team_label(room, position)}
        </:col>
        <:col :let={room} label={gettext("Adjudicator")}>{judge_name(room, @state.signups)}</:col>
        <:col :let={room} label={gettext("Ballot")} class="st">
          {room_status_words(room["status"])}
        </:col>
        <:col :let={room}>
          <.link
            :if={room["status"] in ["pending", "judging"] and room["Motion"] != nil}
            href={~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}/ballot"}
          >
            {gettext("ballot")}
          </.link>
          <.link
            :if={room["status"] in ["completed", "confirmed"] && @state.stage == :running}
            href={~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}/ballot"}
          >
            {gettext("edit ballot")}
          </.link>
        </:col>
      </.table>
    </.section>

    <.section title={gettext("Motions")}>
      <.table
        id="session-motions"
        rows={@state.rooms}
        row_href={fn room -> ~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}" end}
      >
        <:col :let={room} class="rank">{room_label(room)}</:col>
        <:col :let={room} label={gettext("Motion")}>
          <%= if motion = room["Motion"] do %>
            <b>{motion["motion_text"]}</b>
          <% else %>
            <span class="mut">{gettext("not published yet")}</span>
          <% end %>
        </:col>
        <:col :let={room} label={gettext("Infoslide")}>
          {get_in(room, ["Motion", "infoslide"]) || "—"}
        </:col>
        <:col :let={room} label={gettext("Keyword")}>
          {get_in(room, ["Motion", "keyword"]) || "—"}
        </:col>
      </.table>
    </.section>
<% end %>
