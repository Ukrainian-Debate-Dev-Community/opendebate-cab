<%= case @state.stage do %>
  <% :signup -> %>
    <.section title={allocation_title(@current, @state.signups)}>
      <div class="pad">
        <p>
          <%= if @current.draft_rooms do %>
            {gettext(
              "You set the number of rooms by hand; Automatic makes it follow the sign-ups again;"
            )}
          <% else %>
            {gettext(
              "A room seats %{seats} (%{speakers} speakers and an adjudicator), so the room count follows the sign-ups;",
              seats: Cab.Format.room_seats(Cab.Format.of(@current)),
              speakers: Cab.Format.speeches(Cab.Format.of(@current))
            )}
          <% end %>
          <b>{gettext("nobody is placed automatically")}</b>
          {gettext("— drag people from the tray into the slots, then")}
          <b>{gettext("Start session")}</b>
          {gettext("closes registration and opens these rooms.")}
        </p>
      </div>
      <.allocator
        format={Cab.Format.of(@current)}
        rooms={Cab.Sessions.rooms_for(@current, @state.signups)}
        auto={is_nil(@current.draft_rooms)}
        max_rooms={Cab.Sessions.max_rooms()}
        count_event="rooms"
        people={people(@state.signups)}
        draft={@draft}
        form_id="allocator-form"
        submit="start"
      />
    </.section>
  <% :closed -> %>
    <.section title={allocation_title(@current, @state.signups)}>
      <div class="pad">
        <p>
          {attendance_line(@current, @state.signups)}
          <b>{gettext("Nobody is placed automatically")}</b>
          {gettext("— drag people from the tray into the slots.")}
        </p>
      </div>
      <.allocator
        format={Cab.Format.of(@current)}
        rooms={Cab.Sessions.rooms_for(@current, @state.signups)}
        auto={is_nil(@current.draft_rooms)}
        max_rooms={Cab.Sessions.max_rooms()}
        count_event="rooms"
        people={people(@state.signups)}
        draft={@draft}
        form_id="allocator-form"
        submit="make_rooms"
      />
    </.section>
  <% _running_or_done -> %>
    <.section title={gettext("Rooms")}>
      <.table
        id="session-rooms"
        rows={@state.rooms}
        row_href={fn room -> ~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}" end}
      >
        <:col :let={room} class="rank">
          <.link href={~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}"}>
            {room_label(room)}
          </.link>
        </:col>
        <:col
          :let={room}
          :for={{label, position, side_class} <- sides(Cab.Format.of(@current))}
          label={label}
          class={"side #{side_class}"}
        >
          {team_label(room, position)}
        </:col>
        <:col :let={room} label={gettext("Adjudicator")}>{judge_name(room, @state.signups)}</:col>
        <:col :let={room} label={gettext("Ballot")} class="st">
          {room_status_words(room["status"])}
        </:col>
        <:col :let={room} label={gettext("Feedback")} class="st">
          <%= case ballot_in?(room) && @feedback_progress[room["id"]] do %>
            <% {sent, teams} when teams > 0 -> %>
              {gettext("%{sent} of %{teams} teams", sent: sent, teams: teams)}
            <% _ -> %>
              —
          <% end %>
        </:col>
        <:col :let={room}>
          <.link
            :if={room["status"] in ["pending", "judging"] and room["Motion"] != nil}
            href={~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}/ballot"}
          >
            {gettext("ballot")}
          </.link>
          <.link
            :if={room["status"] in ["completed", "confirmed"] && @state.stage == :running}
            href={~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}/ballot"}
          >
            {gettext("edit ballot")}
          </.link>
        </:col>
      </.table>
    </.section>
<% end %>
