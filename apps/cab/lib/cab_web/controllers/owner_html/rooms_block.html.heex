<%= case @state.stage do %>
  <% :signup -> %>
    <.section title={"Allocation — #{Cab.Sessions.room_count(@state.signups)} room(s), count automatic"}>
      <div class="pad">
        <p>
          A room seats nine (eight speakers and an adjudicator), so the room count follows the sign-ups;
          <b>nobody is placed
          automatically</b>
          — drag people from the tray into the slots, then <b>Start session</b>
          closes registration and opens these rooms.
        </p>
      </div>
      <.allocator
        rooms={Cab.Sessions.room_count(@state.signups)}
        people={people(@state.signups)}
        draft={@draft}
        form_id="allocator-form"
        submit="start"
      />
    </.section>
  <% :closed -> %>
    <.section title={"Allocation — #{Cab.Sessions.room_count(@state.signups)} room(s), count automatic"}>
      <div class="pad">
        <p>
          {attendance_line(@state.signups)} <b>Nobody is placed automatically</b> —
          drag people from the tray into the slots.
        </p>
      </div>
      <.allocator
        rooms={Cab.Sessions.room_count(@state.signups)}
        people={people(@state.signups)}
        draft={@draft}
        form_id="allocator-form"
        submit="make_rooms"
      />
    </.section>
  <% _running_or_done -> %>
    <.section title="Rooms">
      <.table
        id="session-rooms"
        rows={@state.rooms}
        row_href={fn room -> ~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}" end}
      >
        <:col :let={room} class="rank">
          <.link href={~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}"}>
            {room_label(room)}
          </.link>
        </:col>
        <:col
          :let={room}
          :for={{label, position, side_class} <- sides()}
          label={label}
          class={"side #{side_class}"}
        >
          {team_label(room, position)}
        </:col>
        <:col :let={room} label="Adjudicator">{judge_name(room, @state.signups)}</:col>
        <:col :let={room} label="Ballot" class="st">
          {room_status_words(room["status"])}
        </:col>
        <:col :let={room}>
          <.link
            :if={room["status"] in ["pending", "judging"] and room["Motion"] != nil}
            href={~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}/ballot"}
          >
            ballot
          </.link>
          <.link
            :if={room["status"] in ["completed", "confirmed"] && @state.stage == :running}
            href={~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}/ballot"}
          >
            edit ballot
          </.link>
        </:col>
      </.table>
    </.section>

    <.section title="Motions">
      <.table
        id="session-motions"
        rows={@state.rooms}
        row_href={fn room -> ~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{room["id"]}" end}
      >
        <:col :let={room} class="rank">{room_label(room)}</:col>
        <:col :let={room} label="Motion">
          <%= if motion = room["Motion"] do %>
            <b>{motion["motion_text"]}</b>
          <% else %>
            <span class="mut">not published yet</span>
          <% end %>
        </:col>
        <:col :let={room} label="Infoslide">{get_in(room, ["Motion", "infoslide"]) || "—"}</:col>
        <:col :let={room} label="Keyword">{get_in(room, ["Motion", "keyword"]) || "—"}</:col>
        <:col :let={room} label="Prep until">
          <%= if at = prep_until(room) do %>
            <.local_time at={at} as={:time} />
          <% else %>
            —
          <% end %>
        </:col>
      </.table>
      <div :if={open_rooms(@state) != []} class="pad mut">
        Click a room to publish its motion; prep runs 15 minutes from publishing.
      </div>
    </.section>
<% end %>
