<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="club"
>
  <.chrome crumbs={[{@club.name, ~p"/c/#{@club.uuid}"}]} here={gettext("Edit")}>
    <:seg href={~p"/c/#{@club.uuid}"} quiet>{gettext("View as public")}</:seg>
    <:seg form="open-session-form" primary={is_nil(@live)}>
      {gettext("Open new session")}
    </:seg>
    <:seg form="club-profile-form" primary={not is_nil(@live)}>{gettext("Save")}</:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.section title={gettext("Club profile")}>
      <.form_for
        id="club-profile-form"
        action={~p"/c/#{@club.uuid}/owner/club"}
        description={gettext("Exactly what visitors read on the club page.")}
      >
        <:block
          name={:name}
          type={:text}
          label={gettext("Club name")}
          required
          value={@club.name}
        />
        <:block name={:city} type={:text} label={gettext("City")} value={@club.city} />
        <:block
          name={:meeting_info}
          type={:text}
          label={gettext("Meetings")}
          value={@club.meeting_info}
          hint={gettext("When and where the club meets, e.g. Thursdays 18:30, Hrushevskoho 4.")}
        />
        <:block
          name={:description}
          type={:longtext}
          label={gettext("About the club")}
          value={@club.description}
        />
        <:block
          name={:contacts}
          type={:text}
          label={gettext("Contacts")}
          value={@club.contacts}
          hint={gettext("Telegram, email — how newcomers reach the club.")}
        />
        <:block
          name={:formats}
          type={:multi}
          label={gettext("Format")}
          value={@club.formats}
          options={CabWeb.ClubProfile.format_options()}
          hint={gettext("Tick all that apply.")}
        />
        <:block
          name={:languages}
          type={:multi}
          label={gettext("Language")}
          value={@club.languages}
          options={CabWeb.ClubProfile.language_options()}
        />
        <:block
          name={:audiences}
          type={:multi}
          label={gettext("Audience")}
          value={@club.audiences}
          options={CabWeb.ClubProfile.audience_options()}
        />
        <:block
          name={:is_private}
          type={:select}
          label={gettext("Standings")}
          value={if @club.is_private, do: "true", else: "false"}
          options={[{gettext("public"), "false"}, {gettext("members only"), "true"}]}
          hint={
            gettext(
              "Members only also keeps the club out of the global standings. Everything else stays public."
            )
          }
        />
      </.form_for>
    </.section>

    <.banner
      :if={@live}
      kind={:info}
      href={~p"/c/#{@club.uuid}/owner/s/#{@live.uuid}"}
      link={gettext("Open")}
    >
      {gettext("The current session lives under Rooms.")}
    </.banner>

    <.archive_section club={@club} archive={@archive} />

    <.section title={gettext("Open a session")}>
      <.form_for
        id="open-session-form"
        action={~p"/c/#{@club.uuid}/owner/sessions"}
        description={gettext("Registration opens as soon as you open the session.")}
      >
        <:block
          name={:name}
          type={:text}
          label={gettext("Session name")}
          hint={gettext("Shown to members on the club page; defaults to the date.")}
        />
        <:block
          names={[:date, :time]}
          type={:datetime}
          label={gettext("Date and start time")}
          hint={gettext("Optional — when the session is planned to start, in your time zone.")}
        />
      </.form_for>
    </.section>
  </div>
</Layouts.app>
