<%= if @state.stage == :signup do %>
  <.copy_banner
    id="shared-registration-url"
    url={url(~p"/c/#{@club.uuid}?#{[session: @session_uuid]}") <> "#register"}
  >
    {gettext("Share to register: the club page")}
  </.copy_banner>

  <.section title={gettext("Add a person")}>
    <div class="pad addp">
      <form
        id="add-person-form"
        action={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/signups"}
        method="post"
        phx-change="search"
        phx-submit="add_typed"
        autocomplete="off"
      >
        <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
        <label for="add-person-q">{gettext("Member, registered user or guest")}</label>
        <input
          id="add-person-q"
          type="search"
          name="q"
          value={@query}
          phx-debounce="250"
          placeholder={gettext("Pick a member, or type a name, a user's username or email")}
        />
      </form>
      <div
        class={["suggest", String.trim(@query) == "" && "idle"]}
        id="add-person-suggestions"
        tabindex="-1"
      >
        <button
          :for={user <- @suggestions.members}
          type="button"
          phx-click="add_member"
          phx-value-id={user.id}
        >
          {user.name || user.username} <span>{gettext("member")}</span>
        </button>
        <button
          :for={user <- @suggestions.users}
          type="button"
          phx-click="invite"
          phx-value-id={user.id}
        >
          {user.name || user.username}
          <span>{gettext("registered user, will accept on My page")}</span>
        </button>
        <div :if={@suggestions.guest} class="guest-offer">
          <button type="button" phx-click="add_guest" phx-value-name={@suggestions.guest}>
            {gettext("Add \"%{name}\" as a guest", name: @suggestions.guest)}
            <span>{gettext("not in cab")}</span>
          </button>
          <p>{gettext("Send them their personal link from People.")}</p>
        </div>
        <.form
          :if={email_only?(@query, @suggestions)}
          for={%{}}
          id="add-guest-by-email"
          class="guest-offer by-email"
          phx-submit="add_guest_by_email"
        >
          <input type="hidden" name="email" value={String.trim(@query)} />
          <label for="add-guest-name">
            {gettext("Nobody in cab uses %{email}. Their name", email: String.trim(@query))}
          </label>
          <div class="row">
            <input
              id="add-guest-name"
              type="text"
              name="name"
              required
              maxlength={Cab.Links.name_max()}
              autocomplete="off"
            />
            <button type="submit">{gettext("Add as a guest")}</button>
          </div>
          <p>{gettext("We e-mail them their personal link; the address is not stored.")}</p>
        </.form>
        <p :if={String.trim(@query) == "" and @suggestions.members == []}>
          {gettext("Every member is in this session. Type a name to add a guest.")}
        </p>
      </div>
    </div>
  </.section>
<% end %>
