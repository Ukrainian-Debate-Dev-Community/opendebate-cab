<%= if @state.stage == :signup do %>
  <.copy_banner id="shared-registration-url" url={url(~p"/r/#{@current.uuid}")}>
    Share to register without an account
  </.copy_banner>

  <.section title="Add a person">
    <.form_for
      id="add-person-form"
      action={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/signups"}
      description="Pick a club member, or type a guest's name to give them a personal link."
    >
      <:block
        name={:username}
        type={:select}
        label="Member"
        options={[{"—", ""} | addable_members(@members, @state.signups)]}
      />
      <:block name={:name} type={:text} label="or a guest" hint="Guest's name." />
      <:submit note="They appear in tonight's list right away.">Add</:submit>
    </.form_for>
  </.section>
<% end %>
