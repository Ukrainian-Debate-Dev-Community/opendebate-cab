<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="club"
>
  <.chrome
    crumbs={[
      {@club.name, ~p"/c/#{@club.uuid}"},
      {gettext("Club"), ~p"/c/#{@club.uuid}/owner"},
      {gettext("Registration form"), ~p"/c/#{@club.uuid}/owner/form"}
    ]}
    here={gettext("Preview")}
  >
    <:seg href={~p"/c/#{@club.uuid}/owner/form"} primary>{gettext("Back to editing")}</:seg>
  </.chrome>

  <div class="pbody">
    <.page_head kicker={gettext("Registration form preview")} title={@club.name} />

    <.banner kind={:info}>
      {gettext(
        "Preview: this is what a visitor without an account sees in the club page's registration section. Nothing can be sent from here."
      )}
    </.banner>

    <div class="narrow">
      <.section title={gettext("Registration")}>
        <CabWeb.RegistrationHTML.guest_form
          action={~p"/c/#{@club.uuid}/owner/form/preview"}
          title={gettext("Register for %{session}", session: gettext("the next spar"))}
          fields={@fields}
          logo={CabWeb.ClubProfile.logo_path(@club)}
          preview
        />
      </.section>
    </div>
  </div>
</Layouts.app>
