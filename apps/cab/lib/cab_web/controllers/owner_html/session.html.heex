<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="rooms"
>
  <.chrome
    crumbs={[
      {@club.name, ~p"/c/#{@club.uuid}"},
      {gettext("Club"), ~p"/c/#{@club.uuid}/owner"}
    ]}
    here={"#{@state.event["name"]} — #{stage_words(@state.stage)}"}
  >
    <:seg href={~p"/c/#{@club.uuid}/owner/form"}>{gettext("Registration form")}</:seg>
    <:seg href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/responses"}>
      {gettext("Responses")}
    </:seg>
    <:seg :if={@state.stage == :signup} form="allocator-form" primary>
      {gettext("Start session")}
    </:seg>
    <:seg :if={@state.stage == :closed} form="allocator-form" primary>
      {gettext("Start session")}
    </:seg>
    <:seg
      :if={@state.stage == :closed}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/reopen-signups"}
      method="post"
    >
      {gettext("Reopen registration")}
    </:seg>
    <:seg
      :if={@my_ballot_room}
      href={~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{@my_ballot_room["id"]}/ballot"}
    >
      {gettext("Fill ballot — %{room}", room: room_label(@my_ballot_room))}
    </:seg>
    <:seg
      :if={Cab.Sessions.deletable?(@state)}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/delete"}
      quiet
    >
      {gettext("Delete session")}
    </:seg>
    <:seg
      :if={@state.stage == :running && deletable_rooms?(@state)}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/reopen-registration"}
      method="post"
      quiet
    >
      {gettext("Delete rooms")}
    </:seg>
    <:seg
      :if={@state.stage == :running}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/finish"}
      method="post"
      primary
    >
      {gettext("Finish session")}
    </:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <%= if @state.stage == :done do %>
      <.section title={gettext("Session")} pad>
        {gettext("This session is finished — results live on the")}
        <.link href={~p"/c/#{@club.uuid}/s/#{@current.uuid}"}>{gettext("session page")}</.link>.
        <p>
          {gettext("Previous sessions live on the")}
          <.link href={~p"/c/#{@club.uuid}/owner"}>{gettext("club page")}</.link>.
        </p>
      </.section>
      {feedback_block(assigns)}
    <% else %>
      {registration_block(assigns)}
      {signups_block(assigns)}
      {rooms_block(assigns)}
    <% end %>
  </div>
</Layouts.app>
