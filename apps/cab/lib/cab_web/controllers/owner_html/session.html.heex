<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="rooms"
>
  <%!-- the command bar carries the actions of the stage on view --%>
  <.chrome
    crumbs={[
      {@club.name, ~p"/c/#{@club.uuid}"},
      {gettext("Club"), ~p"/c/#{@club.uuid}/owner"}
    ]}
    here={"#{@state.event["name"]} — #{stage_words(@state.stage)}"}
  >
    <:seg :if={@view == :registration} href={~p"/c/#{@club.uuid}/owner/form"}>
      {gettext("Registration form")}
    </:seg>
    <:seg
      :if={@view == :registration}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/responses"}
    >
      {gettext("Responses")}
    </:seg>
    <:seg
      :if={@view == :registration and @state.stage == :signup}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/close-signups"}
      method="post"
    >
      {gettext("Close registration")}
    </:seg>
    <:seg
      :if={@view == :registration and @state.stage == :closed}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/reopen-signups"}
      method="post"
    >
      {gettext("Reopen registration")}
    </:seg>
    <:seg
      :if={@view == :registration and Cab.Sessions.deletable?(@state)}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/delete"}
      quiet
    >
      {gettext("Delete session")}
    </:seg>
    <:seg
      :if={@view == :rooms and @state.stage in [:signup, :closed]}
      form="allocator-form"
      primary
    >
      {gettext("Start session")}
    </:seg>
    <:seg
      :if={@view == :rooms and deletable_rooms?(@state)}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/reopen-registration"}
      method="post"
      quiet
    >
      {gettext("Delete rooms")}
    </:seg>
    <:seg
      :if={@view == :debates and @my_ballot_room}
      href={~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{@my_ballot_room["id"]}/ballot"}
    >
      {gettext("Fill ballot — %{room}", room: room_label(@my_ballot_room))}
    </:seg>
    <:seg
      :if={@view == :debates and @state.stage == :running}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/finish"}
      method="post"
      primary
    >
      {gettext("Finish session")}
    </:seg>
    <:seg
      :if={@view == :finished and @state.stage == :done}
      href={~p"/c/#{@club.uuid}/s/#{@current.uuid}"}
    >
      {gettext("Results")}
    </:seg>
    <:seg
      :if={@view == :finished and @state.stage == :done}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/reopen"}
      method="post"
      quiet
    >
      {gettext("Reopen session")}
    </:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.page_head kicker={gettext("Run the session")} title={@state.event["name"]}>
      <:meta>
        <.local_time :if={@current.scheduled_at} at={@current.scheduled_at} as={:datetime} />
        <.tag kind={stage_kind(@state.stage)}>{stage_words(@state.stage)}</.tag>
      </:meta>
    </.page_head>

    <%!-- where the session is; each stage opens its own part of the page --%>
    <.steps label={gettext("Session stages")}>
      <:step
        :for={{step, name} <- step_names()}
        state={step_state(@state, step)}
        patch={~p"/c/#{@club.uuid}/owner/s/#{@current.uuid}?#{[stage: step]}"}
        open={@view == step}
      >
        {name}
      </:step>
    </.steps>

    <%!-- the numbers once there are rooms; before, People counts the sign-ups --%>
    <.stats :if={@state.rooms != []}>
      <:stat label={gettext("Registered")}>{length(@state.signups)}</:stat>
      <:stat label={gettext("Rooms")}>{length(@state.rooms)}</:stat>
      <:stat label={gettext("Ballots in")}>{ballots_in(@state.rooms)}</:stat>
    </.stats>

    <%= case @view do %>
      <% :registration -> %>
        <.copy_banner :if={@state.stage == :signup} id="shared-registration-url" url={@short_url}>
          {gettext("Share to register: the club page")}
        </.copy_banner>
        <.banner :if={@state.stage != :signup} kind={:info}>
          {gettext("Registration is closed for this session.")}
        </.banner>
        <%!-- the people beside what changes them (on phones the forms lead) --%>
        <%= if @state.stage in [:signup, :closed] do %>
          <div class="split">
            <div class="stack">{signups_block(assigns)}</div>
            <div class="stack lead">
              {registration_block(assigns)}
              {schedule_block(assigns)}
            </div>
          </div>
        <% else %>
          {signups_block(assigns)}
        <% end %>
      <% :rooms -> %>
        {rooms_block(assigns)}
      <% :debates -> %>
        <%= if @state.rooms != [] do %>
          {debates_block(assigns)}
        <% else %>
          <.section title={gettext("Debates")} pad>
            {gettext(
              "The debates start with the rooms: place everyone under Rooms, then Start session."
            )}
          </.section>
        <% end %>
      <% :finished -> %>
        <.section title={gettext("Session")} pad>
          <%= if @state.stage == :done do %>
            {gettext("This session is finished — results live on the")}
            <.link href={~p"/c/#{@club.uuid}/s/#{@current.uuid}"}>{gettext("session page")}</.link>.
            <p>
              {gettext(
                "Reopen it to edit a ballot or finish again: the results stay, the winners are recorded anew."
              )}
            </p>
          <% else %>
            {gettext("When the debates are over, Finish session records the winners.")}
          <% end %>
        </.section>
    <% end %>
  </div>
</Layouts.app>
