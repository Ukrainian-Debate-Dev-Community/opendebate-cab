<Layouts.app
  flash={@flash}
  current_user={@current_user}
  club={@club}
  club_role={@club_role}
  nav_session={@nav_session}
  active="rooms"
>
  <.chrome
    crumbs={[
      {@club.name, ~p"/c/#{@club.uuid}"},
      {gettext("Club"), ~p"/c/#{@club.uuid}/owner"}
    ]}
    here={"#{@state.event["name"]} — #{stage_words(@state.stage)}"}
  >
    <:seg href={~p"/c/#{@club.uuid}/owner/form"}>{gettext("Registration form")}</:seg>
    <:seg href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/responses"}>
      {gettext("Responses")}
    </:seg>
    <:seg :if={@state.stage == :signup} form="allocator-form" primary>
      {gettext("Start session")}
    </:seg>
    <:seg :if={@state.stage == :closed} form="allocator-form" primary>
      {gettext("Start session")}
    </:seg>
    <:seg
      :if={@state.stage == :closed}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/reopen-signups"}
      method="post"
    >
      {gettext("Reopen registration")}
    </:seg>
    <:seg
      :if={@my_ballot_room}
      href={~p"/c/#{@club.uuid}/s/#{@current.uuid}/rooms/#{@my_ballot_room["id"]}/ballot"}
    >
      {gettext("Fill ballot — %{room}", room: room_label(@my_ballot_room))}
    </:seg>
    <:seg
      :if={Cab.Sessions.deletable?(@state)}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/delete"}
      quiet
    >
      {gettext("Delete session")}
    </:seg>
    <:seg
      :if={@state.stage == :running && deletable_rooms?(@state)}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/reopen-registration"}
      method="post"
      quiet
    >
      {gettext("Delete rooms")}
    </:seg>
    <:seg
      :if={@state.stage == :running}
      href={~p"/c/#{@club.uuid}/owner/sessions/#{@current.uuid}/finish"}
      method="post"
      primary
    >
      {gettext("Finish session")}
    </:seg>
  </.chrome>

  <div class="pbody">
    <.flash_banners flash={@flash} />

    <.page_head kicker={gettext("Run the session")} title={@state.event["name"]}>
      <:meta>
        <.local_time :if={@current.scheduled_at} at={@current.scheduled_at} as={:datetime} />
        <.tag kind={stage_kind(@state.stage)}>{stage_words(@state.stage)}</.tag>
      </:meta>
    </.page_head>

    <.steps label={gettext("Session stages")}>
      <:step state={step_state(@state, :registration)}>{gettext("Registration")}</:step>
      <:step state={step_state(@state, :rooms)}>{gettext("Rooms")}</:step>
      <:step state={step_state(@state, :debates)}>{gettext("Debates")}</:step>
      <:step state={step_state(@state, :finished)}>{gettext("Finished")}</:step>
    </.steps>

    <%!-- the numbers once there are rooms; before, People counts the sign-ups --%>
    <.stats :if={@state.rooms != []}>
      <:stat label={gettext("Registered")}>{length(@state.signups)}</:stat>
      <:stat label={gettext("Rooms")}>{length(@state.rooms)}</:stat>
      <:stat label={gettext("Ballots in")}>{ballots_in(@state.rooms)}</:stat>
    </.stats>

    <%= case @state.stage do %>
      <% :done -> %>
        <.section title={gettext("Session")} pad>
          {gettext("This session is finished — results live on the")}
          <.link href={~p"/c/#{@club.uuid}/s/#{@current.uuid}"}>{gettext("session page")}</.link>.
          <p>
            {gettext("Previous sessions live on the")}
            <.link href={~p"/c/#{@club.uuid}/owner"}>{gettext("club page")}</.link>.
          </p>
        </.section>
        {feedback_block(assigns)}
      <% :running -> %>
        {rooms_block(assigns)}
        {signups_block(assigns)}
      <% _signup_or_closed -> %>
        <.copy_banner :if={@state.stage == :signup} id="shared-registration-url" url={@short_url}>
          {gettext("Share to register: the club page")}
        </.copy_banner>
        <%!-- the people beside what changes them (on phones the forms lead);
             the allocator needs the full width under them --%>
        <div class="split">
          <div class="stack">{signups_block(assigns)}</div>
          <div class="stack lead">
            {registration_block(assigns)}
            {schedule_block(assigns)}
          </div>
        </div>
        {rooms_block(assigns)}
    <% end %>
  </div>
</Layouts.app>
