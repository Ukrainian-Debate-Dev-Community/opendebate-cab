<%= if @tab == "clubs" do %>
  <.section title={gettext("Clubs")}>
    <.table id="standings-clubs" rows={@rows} rank empty={gettext("No clubs yet.")}>
      <:col :let={row} label={gettext("Club")}>
        <.link href={~p"/c/#{row.club.uuid}"}>{row.club.name}</.link>
      </:col>
      <:col :let={row} label={gettext("City")}>{row.club.city || "—"}</:col>
      <:col :let={row} label={gettext("Members")} num>{row.members}</:col>
      <:col :let={row} label={gettext("Sessions")} num>{row.sessions}</:col>
      <:col :let={row} label={gettext("Rooms")} num>{row.rooms}</:col>
    </.table>
  </.section>
<% else %>
  <%= if @scope do %>
    <.section title={tab_label(@tab)}>
      <div class="pad scope-card">
        <p>
          {gettext("session:")} <b>{@scope.session.name}</b>,
          <.local_time at={scope_date(@scope)} as={:day} />, {@scope.club.name}{if assigns[
                                                                                     :archive
                                                                                   ],
                                                                                   do:
                                                                                     " " <>
                                                                                       gettext(
                                                                                         "(latest finished)"
                                                                                       )}
        </p>
        <div :if={earlier_rows(assigns) != []} class="flinks">
          <span class="mut">{gettext("earlier:")}</span>
          <.link
            :for={row <- earlier_rows(assigns)}
            href={"#{@base}/#{@tab}?session=#{row.session_uuid}"}
          >
            {row.name}, <.local_time at={row.date} as={:day} />
          </.link>
        </div>
      </div>
      <.table
        id={"standings-#{@tab}"}
        rows={@rows}
        rank
        empty={gettext("No results for this session yet.")}
      >
        <:col :let={row} :if={@tab == "teams"} label={gettext("Team")}>{row["name"]}</:col>
        <:col :let={row} :if={@tab == "speakers"} label={gettext("Speaker")}>{row["name"]}</:col>
        <:col :let={row} :if={@tab in ["teams", "speakers"]} label={gettext("Points")} num>
          {row["total_points"]}
        </:col>
        <:col :let={row} :if={@tab == "speakers"} label={gettext("Avg score")} num>
          {row["average_score"] || "—"}
        </:col>
        <:col :let={row} :if={@tab == "speakers"} label={gettext("Speeches")} num>
          {row["speeches"] || "—"}
        </:col>
        <:col :let={row} :if={@tab == "adjudicators"} label={gettext("Adjudicator")}>
          {row["name"]}
        </:col>
        <:col :let={row} :if={@tab == "adjudicators"} label={gettext("Rooms adjudicated")} num>
          {row["rooms_adjudicated"]}
        </:col>
        <:col :let={row} :if={@tab == "adjudicators"} label={gettext("Avg feedback")} num>
          {row["avg_feedback"] || "—"}
        </:col>
      </.table>
      <div :if={@tab == "adjudicators"} class="pad mut">
        {gettext(
          "Avg feedback counts a base of 5 as one vote: (5 + every feedback score) / (feedback count + 1)."
        )}
      </div>
    </.section>
  <% else %>
    <.section title={tab_label(@tab)} pad>
      {gettext("No finished session yet.")}
      <p>{gettext("Standings show the latest finished session.")}</p>
    </.section>
  <% end %>
<% end %>
