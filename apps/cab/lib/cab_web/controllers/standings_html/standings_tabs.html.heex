<.selrow
  id="standings-tabs"
  active={@active}
  tabs={
    [
      {"teams", "Teams", "#{@base}/teams"},
      {"speakers", "Speakers", "#{@base}/speakers"},
      {"adjudicators", "Adjudicators", "#{@base}/adjudicators"}
    ] ++ if(@clubs_tab, do: [{"clubs", "Clubs", "#{@base}/clubs"}], else: [])
  }
/>
