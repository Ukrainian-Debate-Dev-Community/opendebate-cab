<.selrow
  id="standings-tabs"
  active={@active}
  tabs={
    [
      {"teams", gettext("Teams"), "#{@base}/teams"},
      {"speakers", gettext("Speakers"), "#{@base}/speakers"},
      {"adjudicators", gettext("Adjudicators"), "#{@base}/adjudicators"}
    ] ++ if(@clubs_tab, do: [{"clubs", gettext("Clubs"), "#{@base}/clubs"}], else: [])
  }
/>
