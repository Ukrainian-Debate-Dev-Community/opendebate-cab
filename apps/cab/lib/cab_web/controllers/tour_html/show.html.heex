<%!-- the player: the demo page in a frame with a spotlight and the
     caption beside it; the bar under it shows the chapters and the
     progress. Without the browser's script the steps read as a list --%>
<div
  class="tour"
  id="tour"
  data-tour={@tour.key}
  data-steps={steps_json(@tour)}
  data-label-play={gettext("Play")}
  data-label-pause={gettext("Pause")}
  data-label-replay={gettext("Replay")}
>
  <header class="tour-top">
    <.link href={~p"/tour"} class="tour-back">{gettext("All tours")}</.link>
    <span class="tour-title">
      <b>{@tour.title}</b>
      <span class="tour-as">{gettext("You see:")} <b class="tour-as-name"></b></span>
    </span>
    <.link href={~p"/"} class="tour-exit">{gettext("Exit")}</.link>
  </header>

  <div class="tour-stage">
    <iframe class="tour-frame" title={gettext("Demo page")} tabindex="-1"></iframe>
    <div class="tour-card" hidden>
      <p class="tour-card-chapter"></p>
      <p class="tour-card-text"></p>
      <%!-- the welcome card lists what is coming --%>
      <ol class="tour-card-chapters">
        <li :for={chapter <- CabWeb.Tour.chapters(@tour) |> Enum.slice(1..-2//1)}>{chapter}</li>
      </ol>
      <%!-- the last card: where to go next --%>
      <div class="tour-card-next">
        <.link href={~p"/"} class="btn-go">{gettext("Find a club")}</.link>
        <.link :for={other <- @others} href={~p"/tour/#{other.key}"} class="btn-quiet">
          {other.title}
        </.link>
      </div>
    </div>
  </div>

  <div class="tour-bar" role="region" aria-label={gettext("Tour")}>
    <button type="button" class="tour-play"></button>
    <div class="tour-progress">
      <ol class="tour-chapters" aria-label={gettext("Chapters")}>
        <li :for={{chapter, index} <- Enum.with_index(CabWeb.Tour.chapters(@tour))}>
          <button type="button" data-chapter={index} title={chapter}>
            <span class="tour-chapter-name">{chapter}</span>
          </button>
        </li>
      </ol>
      <input
        type="range"
        class="tour-slider"
        min="0"
        max={length(@tour.steps) - 1}
        value="0"
        step="1"
        aria-label={gettext("Step")}
      />
    </div>
    <span class="tour-count"></span>
  </div>

  <ol class="tour-steps">
    <li :for={step <- @tour.steps}><b>{step.chapter}.</b> {step.text}</li>
  </ol>

  <nav class="tour-more" aria-label={gettext("Other tours")}>
    <.link :for={other <- @others} href={~p"/tour/#{other.key}"}>{other.title}</.link>
  </nav>
</div>
