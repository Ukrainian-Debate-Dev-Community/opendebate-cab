<.section title={gettext("Club Sessions")}>
  <.table id="club-sessions" rows={@archive} empty={gettext("No sessions yet.")}>
    <:col :let={row} label={gettext("Session")}>
      <.link href={~p"/c/#{@club.uuid}/s/#{row.session_uuid}"}>{row.name}</.link>
      <.sub><.local_time at={row.date} as={:date} /></.sub>
    </:col>
    <:col :let={row} label={gettext("Status")} class="st">
      <%= case row.status do %>
        <% :done -> %>
          {if row.winner,
            do: gettext("done — won by %{winner}", winner: row.winner),
            else: gettext("done")}
        <% :live -> %>
          <b>{gettext("running")}</b>
        <% :open -> %>
          {gettext("registration open")}
      <% end %>
    </:col>
  </.table>
</.section>
