<.section title={gettext("Club Sessions")}>
  <.table id="club-sessions" rows={@archive} empty={gettext("No sessions yet.")}>
    <:col :let={row} label={gettext("Session")}>{row.name}</:col>
    <:col :let={row} label={gettext("Date and time")}>
      <.local_time at={row.date} as={:short} />
    </:col>
    <:col :let={row} label={gettext("Status")} class="st">
      <%= case row.status do %>
        <% :open -> %>
          {gettext("registration open")}
        <% :closed -> %>
          {gettext("registration closed")}
        <% :running -> %>
          <b>{gettext("running")}</b>
        <% :finished -> %>
          {gettext("finished")}
      <% end %>
    </:col>
    <:col :let={row} label={gettext("Action")}>
      <%= cond do %>
        <% @owner -> %>
          <.link href={~p"/c/#{@club.uuid}/owner/s/#{row.session_uuid}"} class="btn-quiet btn-sm">
            {gettext("Open")}
          </.link>
        <% row.status == :open and Map.has_key?(@mine, row.session_uuid) -> %>
          <.link
            href={
              ~p"/c/#{@club.uuid}/s/#{row.session_uuid}/signups/#{@mine[row.session_uuid]}/remove?from=club"
            }
            method="post"
            class="btn-quiet btn-sm"
          >
            {gettext("Cancel registration")}
          </.link>
        <% row.status == :open -> %>
          <.link
            href={~p"/c/#{@club.uuid}?#{[session: row.session_uuid]}" <> "#register"}
            class="btn-quiet btn-sm"
          >
            {gettext("Register")}
          </.link>
        <% true -> %>
          <.link href={~p"/c/#{@club.uuid}/s/#{row.session_uuid}"} class="btn-quiet btn-sm">
            {gettext("Open")}
          </.link>
      <% end %>
    </:col>
  </.table>
</.section>
