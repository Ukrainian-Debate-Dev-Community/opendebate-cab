#: lib/cab/invitations.ex:150
#, elixir-autogen, elixir-format
msgid "%{name} is already invited."
msgstr "%{name} вже запрошено."

#: lib/cab/sessions.ex:640
#, elixir-autogen, elixir-format
msgid "%{name} is not a member of this club."
msgstr "%{name} не є членом цього клубу."

#: lib/cab/sessions.ex:701
#, elixir-autogen, elixir-format
msgid "%{name} is seated in a room. Only people still waiting can be removed."
msgstr "%{name} вже сидить у кімнаті. Видалити можна лише тих, хто ще чекає."

#: lib/cab/accounts.ex:353
#, elixir-autogen, elixir-format
msgid "Both accounts took part in the same session. Ask the club head to remove one of them from it first."
msgstr "Обидва акаунти брали участь в одній сесії. Попросіть голову клубу спершу прибрати з неї один із них."

#: lib/cab/links.ex:245
#, elixir-autogen, elixir-format
msgid "Could not create the personal link. Try again."
msgstr "Не вдалося створити персональне посилання. Спробуйте ще раз."

#: lib/cab/accounts.ex:235
#, elixir-autogen, elixir-format
msgid "Could not link that sign-in. Try again."
msgstr "Не вдалося прив'язати цей спосіб входу. Спробуйте ще раз."

#: lib/cab/links.ex:251
#: lib/cab/links.ex:256
#, elixir-autogen, elixir-format
msgid "Enter a name."
msgstr "Введіть ім'я."

#: lib/cab/sessions.ex:246
#, elixir-autogen, elixir-format
msgid "Enter the date as YYYY-MM-DD."
msgstr "Введіть дату у форматі РРРР-ММ-ДД."

