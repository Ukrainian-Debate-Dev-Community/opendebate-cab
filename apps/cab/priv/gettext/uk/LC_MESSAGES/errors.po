#, elixir-autogen, elixir-format
msgid "Enter the time as HH:MM."
msgstr "Введіть час у форматі ГГ:ХХ."

#: lib/cab/sessions.ex:987
#, elixir-autogen, elixir-format
msgid "Every room must be an object."
msgstr "Кожна кімната має бути об'єктом."

#: lib/cab/sessions.ex:974
#, elixir-autogen, elixir-format
msgid "Every room needs %{count} teams of one or two speakers (a one-speaker team is an iron)."
msgstr "У кожній кімнаті має бути %{count} команди з одного або двох спікерів (команда з одного спікера є айроном)."

#: lib/cab/sessions.ex:963
#, elixir-autogen, elixir-format
msgid "Every room needs an adjudicator."
msgstr "У кожній кімнаті має бути суддя."

#: lib/cab/sessions.ex:1273
#, elixir-autogen, elixir-format
msgid "Every score must be an object."
msgstr "Кожен бал має бути об'єктом."

#: lib/cab/sessions.ex:1256
#, elixir-autogen, elixir-format
msgid "Every score needs a speaker_participant_id."
msgstr "Кожен бал має містити speaker_participant_id."

#: lib/cab/invitations.ex:140
#, elixir-autogen, elixir-format
