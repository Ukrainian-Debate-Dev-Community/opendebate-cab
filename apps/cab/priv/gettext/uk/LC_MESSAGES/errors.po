#, elixir-autogen, elixir-format
msgid "Scores are whole points from 50 to 100."
msgstr "Бали є цілими числами від 50 до 100."

#: lib/cab/sessions.ex
#, elixir-autogen, elixir-format
msgid "Scores must be a list of 8 entries."
msgstr "Бали мають бути списком із 8 записів."

#: lib/cab/links.ex
#, elixir-autogen, elixir-format
